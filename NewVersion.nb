Cell[CellGroupData[{

Cell["Parametric construction of the mirror surface", "Title",
 CellChangeTimes->{{3.9830285214859657`*^9, 
  3.983028524301326*^9}},ExpressionUUID->"5d634078-c2db-4740-bc0a-\
273879f9f11f"],

Cell[CellGroupData[{

Cell["\<\
This section introduces the full parametric construction of the mirror \
surface . The mirror is generated as a collection of local parabolic sections \
defined
in the vertical plane (xz - plane), which are subsequently positioned in \
space
through rigid transformations . Each section is : -oriented according to the \
solar zenith angle (vertical tilt), -rotated according to the geometric solar \
azimuth (horizontal sweep), -translated along the horizontal solar trajectory \
. The combination of these operations produces the complete three - dimensional
geometry of the mirror as an envelope of time - dependent parabolic profiles .\
\>", "Subsection",
 CellChangeTimes->{{3.983028541656225*^9, 
  3.983028544165925*^9}},ExpressionUUID->"f781ee00-2ff8-4fbe-9312-\
716cfd3e3178"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Rigid", " ", "transformation", " ", "in", " ", "3", "D", " ", "space"}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Rigid", " ", "transformation", " ", "of", " ", "a", " ", "3", "D", " ", 
     "point", " ", 
     RowBox[{"set", ":", 
      RowBox[{"-", "first"}]}]}], ",", 
    RowBox[{
     RowBox[{"a", " ", "rotation", " ", "around", " ", "the", " ", "z"}], "-",
      "axis"}], ",", 
    RowBox[{"-", "then"}], ",", 
    RowBox[{
     RowBox[{"a", " ", "translation", " ", "in", " ", "the", " ", "xy"}], "-", 
     RowBox[{
      RowBox[{"plane", ".", "This"}], " ", "transformation", " ", "is", " ", 
      "essential", " ", "to", " ", "correctly", " ", "place", " ", "each", 
      " ", "local", " ", "parabolic", " ", "section", " ", "in", " ", "the", 
      " ", "global", " ", "coordinate", " ", "system"}]}], ",", 
    RowBox[{
    "assigning", " ", "both", " ", "its", " ", "azimuthal", " ", 
     "orientation", " ", "and", " ", "its", " ", "horizontal", " ", 
     "position", " ", "along", " ", "the", " ", "solar", " ", 
     RowBox[{"trajectory", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"TransformCurve", "[", 
     RowBox[{"points_List", ",", "angle_", ",", "dx_", ",", "dy_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rotationMatrix", ",", "rotatedPoints"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Rotation", " ", "matrix", " ", "around", " ", "the", " ", "z"}], "-",
         "axis"}], "*)"}], 
      RowBox[{
       RowBox[{"rotationMatrix", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Cos", "[", "angle", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"Sin", "[", "angle", "]"}]}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Sin", "[", "angle", "]"}], ",", 
            RowBox[{"Cos", "[", "angle", "]"}], ",", "0"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Apply", " ", "rotation"}], "*)"}], 
       RowBox[{"rotatedPoints", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rotationMatrix", ".", "#"}], ")"}], "&"}], "/@", 
         "points"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Apply", " ", "translation", " ", "in", " ", "the", " ", "xy"}], "-",
          "plane"}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"#", "+", 
           RowBox[{"{", 
            RowBox[{"dx", ",", "dy", ",", "0"}], "}"}]}], ")"}], "&"}], "/@", 
        "rotatedPoints"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.983028578118535*^9, 3.983028578118966*^9}},
 CellLabel->"In[65]:=",ExpressionUUID->"f8ed2b75-b8ca-4187-80d9-2cd34e2f508c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Local", " ", "parabolic", " ", "profile", " ", 
    RowBox[{"(", 
     RowBox[{"vertical", " ", "plane"}], ")"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Focal", " ", "length", " ", "of", " ", "the", " ", "parabolic", " ", 
     "cross"}], "-", 
    RowBox[{"section", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"in", " ", "meters"}], ")"}], "."}]}]}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"f", "=", "1"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Local", " ", "x"}], "-", 
      RowBox[{"coordinate", " ", "of", " ", "the", " ", "parabolic", " ", 
       RowBox[{"profile", ".", "The"}], " ", "parabola", " ", "is", " ", 
       "defined", " ", "in", " ", "the", " ", "vertical", " ", "plane", " ", 
       "and", " ", "rotated", " ", "according", " ", "to", " ", "the", " ", 
       "solar", " ", "zenith", " ", "angle"}]}], ",", 
     RowBox[{
     "which", " ", "determines", " ", "the", " ", "inclination", " ", "of", 
      " ", "the", " ", "incident", " ", "solar", " ", 
      RowBox[{"rays", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xref", "[", 
      RowBox[{"dn_", ",", "TST_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"zenith", "[", 
         RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"zenith", "[", 
         RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Local", " ", "z"}], "-", 
     RowBox[{"coordinate", " ", "of", " ", "the", " ", "parabolic", " ", 
      RowBox[{"profile", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"zref", "[", 
      RowBox[{"dn_", ",", "TST_", ",", "t_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"zenith", "[", 
         RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"zenith", "[", 
         RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983028588650745*^9, 3.98302858865103*^9}, 
   3.9830286249543037`*^9},
 CellLabel->"In[66]:=",ExpressionUUID->"0fa4e652-ffc3-4ced-b681-e71188874994"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Focal", " ", "trajectory"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Horizontal", " ", "coordinate", " ", "of", " ", "the", " ", "focal", " ", 
    
    RowBox[{"point", ".", "The"}], " ", "focal", " ", "point", " ", "shifts", 
    " ", "horizontally", " ", "according", " ", "to", " ", "the", " ", 
    "solar", " ", 
    RowBox[{"elevation", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"fx", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "f"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Vertical", " ", "coordinate", " ", "of", " ", "the", " ", "focal", " ", 
     RowBox[{"point", ".", "The"}], " ", "focal", " ", "point", " ", "rises", 
     " ", "and", " ", "descends", " ", "following", " ", "the", " ", "solar", 
     " ", 
     RowBox[{"elevation", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fz", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{"f", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983028599181863*^9, 3.983028599182312*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"925b4db3-31b5-4b69-8c5c-b5c1e9ba381d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Horizontal", " ", "solar", " ", "projection", " ", 
    RowBox[{"(", 
     RowBox[{"geometric", " ", "azimuth"}], ")"}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Horizontal", " ", "x"}], "-", 
     RowBox[{"component", " ", "of", " ", "the", " ", "solar", " ", 
      RowBox[{"direction", ".", "The"}], " ", "projection", " ", "is", " ", 
      "defined", " ", "using", " ", "the", " ", "geometric", " ", "azimuth", 
      " ", "introduced", " ", "previously"}]}], ",", 
    RowBox[{
    "ensuring", " ", "consistency", " ", "with", " ", "the", " ", "model", 
     " ", "reference", " ", 
     RowBox[{"frame", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"azimuth", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Horizontal", " ", "y"}], "-", 
     RowBox[{"component", " ", "of", " ", "the", " ", "solar", " ", 
      RowBox[{"direction", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"azimuth", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983028606736837*^9, 3.9830286207531977`*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"dec72984-e85d-4c40-b67e-f54fd8077dc6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Geometric", " ", "scaling", " ", "parameters"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Facade", " ", "length", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"in", " ", "meters"}], ")"}], ".", "This"}], " ", "parameter", 
