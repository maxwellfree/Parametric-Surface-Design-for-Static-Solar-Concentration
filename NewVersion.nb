Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Section", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Quantitative", " ", "comparison", " ", "between", " ", "day", " ", "170", 
    " ", "and", " ", "day", " ", "176"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "block", " ", "compares", " ", "the", " ", "mirror", " ", 
     "surfaces", " ", "and", " ", "focal", " ", "trajectories", " ", 
     "obtained", " ", "for", " ", "day", " ", "170", " ", "and", " ", "day", 
     " ", "176.", " ", "Since", " ", "both", " ", "surfaces", " ", "are", " ",
      "generated", " ", "with", " ", "the", " ", "same", " ", "parameter", 
     " ", "sampling", " ", "in", " ", "solar", " ", "time", " ", "and", " ", 
     "in", " ", "the", " ", "local", " ", "parabola", " ", "parameter", " ", 
     "t"}], ",", 
    RowBox[{
     RowBox[{"a", " ", "point"}], "-", "to", "-", 
     RowBox[{
     "point", " ", "comparison", " ", "can", " ", "be", " ", "performed", " ", 
      RowBox[{"directly", ".", "The"}], " ", "goal", " ", "is", " ", "to", 
      " ", "quantify", " ", "how", " ", "close", " ", "both", " ", 
      "parametric", " ", "surfaces", " ", "are", " ", "over", " ", "the", " ",
       "selected", " ", "summer", " ", "operating", " ", 
      RowBox[{"interval", "."}]}]}]}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Pointwise", " ", "Euclidean", " ", "distances", " ", "between", " ", 
    "both", " ", "mirror", " ", "surfaces"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"surfacePointDistances", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"EuclideanDistance", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"SurfacesDay170", ",", "1"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"SurfacesDay176", ",", "1"}], "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Pointwise", " ", "Euclidean", " ", "distances", " ", "between", " ", 
     "both", " ", "focal", " ", "trajectories"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"focusPointDistances", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"EuclideanDistance", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"ReactorDay170", ",", "1"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ReactorDay176", ",", "1"}], "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Summary", " ", "statistics", " ", "for", " ", "the", " ", "mirror", " ", 
     "surface"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"surfaceMaxError", "=", 
     RowBox[{"Max", "[", "surfacePointDistances", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"surfaceMeanError", "=", 
     RowBox[{"Mean", "[", "surfacePointDistances", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"surfaceRMSError", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{"surfacePointDistances", "^", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Summary", " ", "statistics", " ", "for", " ", "the", " ", "focal", " ", 
     "trajectory"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"focusMaxError", "=", 
     RowBox[{"Max", "[", "focusPointDistances", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"focusMeanError", "=", 
     RowBox[{"Mean", "[", "focusPointDistances", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"focusRMSError", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{"focusPointDistances", "^", "2"}], "]"}], "]"}]}], ";"}], "\n",
    "\[IndentingNewLine]", 
   RowBox[{"comparisonSummary", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Surface max error [m]\>\"", "->", "surfaceMaxError"}], ",", 
      RowBox[{"\"\<Surface mean error [m]\>\"", "->", "surfaceMeanError"}], 
      ",", 
      RowBox[{"\"\<Surface RMS error [m]\>\"", "->", "surfaceRMSError"}], ",", 
      RowBox[{"\"\<Focus max error [m]\>\"", "->", "focusMaxError"}], ",", 
      RowBox[{"\"\<Focus mean error [m]\>\"", "->", "focusMeanError"}], ",", 
      RowBox[{"\"\<Focus RMS error [m]\>\"", "->", "focusRMSError"}]}], 
     "}"}]}]}]}]], "Input",
