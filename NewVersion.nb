  3.9830289794367123`*^9}},ExpressionUUID->"eecdf4dc-b91d-4a8d-a23a-\
f03be57f44a9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Visual", " ", "comparison", " ", "of", " ", "the", " ", "mirror", " ", 
     "surfaces", " ", "and", " ", "focal", " ", "trajectories", " ", 
     "corresponding", " ", "to", " ", "day", " ", "170", " ", "and", " ", 
     "day", " ", "176.", " ", "Both", " ", "datasets", " ", "are", " ", 
     "plotted", " ", "simultaneously", " ", "in", " ", "order", " ", "to", 
     " ", "qualitatively", " ", "assess", " ", "the", " ", "overlap", " ", 
     "between", " ", "the", " ", "two", " ", 
     RowBox[{"geometries", ".", "This"}], " ", "visualization", " ", 
     "provides", " ", "an", " ", "intuitive", " ", "confirmation", " ", 
     "that", " ", "the", " ", "surfaces", " ", "are", " ", "nearly", " ", 
     "indistinguishable", " ", "within", " ", "the", " ", "selected", " ", 
     "summer", " ", "operating", " ", 
     RowBox[{"interval", ".", "However"}]}], ",", 
    RowBox[{
    "visual", " ", "inspection", " ", "alone", " ", "is", " ", "not", " ", 
     "sufficient", " ", "to", " ", "quantify", " ", "the", " ", 
     RowBox[{"differences", ".", "For"}], " ", "this", " ", "reason"}], ",", 
    RowBox[{
    "a", " ", "detailed", " ", "pointwise", " ", "numerical", " ", 
     "comparison", " ", "is", " ", "performed", " ", "in", " ", "the", " ", 
     "following", " ", 
     RowBox[{"section", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{"Show", "[", 
   RowBox[{"rangoDay170", ",", "rangoDay176"}], "]"}]}]], "Input",
