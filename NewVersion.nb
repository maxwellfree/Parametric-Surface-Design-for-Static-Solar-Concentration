Cell[CellGroupData[{

Cell["Local parabolic profile driven by solar elevation", "Title",
 CellChangeTimes->{{3.983028206466506*^9, 
  3.9830282118177834`*^9}},ExpressionUUID->"868a51be-74d6-41b5-ac46-\
d77774aeabc9"],

Cell[CellGroupData[{

Cell["\<\
This section illustrates how the local parabolic cross - section of the \
mirror evolves throughout the day as a function of the solar elevation . The \
purpose of this block is mainly interpretative : through static examples and \
animations, it helps to understand how each parabola tilts, rises, and \
descends as the Sun moves from morning to afternoon . In this stage, only the \
vertical plane (xz - plane) is considered . The horizontal azimuthal sweep \
will be introduced later in the full three - dimensional construction of the \
mirror surface .
Mirror profile for a fixed day.This section illustrates how each local \
parabolic cross-section is generated in the vertical plane as a function of \
solar time.The local profile is controlled by the solar zenith angle,whereas \
the horizontal azimuthal sweep is introduced later in the full 3D \
construction of the mirror surface.\
\>", "Subsection",
 CellChangeTimes->{{3.983028222075953*^9, 
  3.983028262267428*^9}},ExpressionUUID->"a31c00b1-c071-4668-923a-\
606490dad16c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Reference", " ", "day", " ", "and", " ", "geometric", " ", "parameters"}],
    "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Selected", " ", "day", " ", "of", " ", "the", " ", 
     RowBox[{"year", ".", "This"}], " ", "example", " ", "uses", " ", "day", 
     " ", "160"}], ",", 
    RowBox[{
     RowBox[{
     "corresponding", " ", "approximately", " ", "to", " ", "early", " ", 
      "June", " ", "in", " ", "a", " ", "non"}], "-", 
     RowBox[{"leap", " ", 
      RowBox[{"year", "."}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"dn", "=", "160"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Focal", " ", "length", " ", "of", " ", "the", " ", "parabolic", " ", 
     "mirror", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"in", " ", "meters"}], ")"}], "."}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"f", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Local", " ", "orientation", " ", "of", " ", "the", " ", "parabolic", " ",
      "profile"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Local", " ", "rotation", " ", "angle", " ", "of", " ", "the", " ", 
      "parabolic", " ", 
      RowBox[{"section", ".", "The"}], " ", "profile", " ", "is", " ", 
      "oriented", " ", "according", " ", "to", " ", "the", " ", "solar", " ", 
      "zenith", " ", "angle"}], ",", 
     RowBox[{
     "which", " ", "defines", " ", "the", " ", "inclination", " ", "of", " ", 
      "the", " ", "incoming", " ", "solar", " ", "rays", " ", "in", " ", 
      "the", " ", "vertical", " ", 
      RowBox[{"plane", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"thetaLocal", "[", "TST_", "]"}], ":=", 
     RowBox[{"zenith", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Parametric", " ", "definition", " ", "of", " ", "the", " ", "parabolic", 
     " ", "profile"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Local", " ", "x"}], "-", 
     RowBox[{"coordinate", " ", "of", " ", "the", " ", "rotated", " ", 
      RowBox[{"parabola", ".", "The"}], " ", "expression", " ", "corresponds",
       " ", "to", " ", "a", " ", "standard", " ", "parabola", " ", "rotated", 
      " ", "by", " ", "the", " ", "zenith", " ", 
      RowBox[{"angle", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"xLocal", "[", 
      RowBox[{"t_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Local", " ", "z"}], "-", 
     RowBox[{"coordinate", " ", "of", " ", "the", " ", "rotated", " ", 
      RowBox[{"parabola", "."}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"zLocal", "[", 
      RowBox[{"t_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"t", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"t", "^", "2"}], "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Focal", " ", "point", " ", "associated", " ", "with", " ", "the", " ", 
     "solar", " ", "elevation"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "The", " ", "focal", " ", "point", " ", "follows", " ", "the", " ", 
     "solar", " ", "elevation", " ", 
     RowBox[{"angle", ".", "Its"}], " ", "position", " ", "shifts", " ", 
     "vertically", " ", "throughout", " ", "the", " ", "day", " ", "as", " ", 
     "the", " ", "Sun", " ", "rises", " ", "and", " ", 
     RowBox[{"sets", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"fxLocal", "[", "TST_", "]"}], ":=", 
     RowBox[{
      RowBox[{"-", "f"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"fzLocal", "[", "TST_", "]"}], ":=", 
     RowBox[{"f", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Static", " ", 
     RowBox[{"example", ":", 
      RowBox[{"single", " ", "solar", " ", "time"}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Example", " ", "of", " ", "the", " ", "parabolic", " ", "profile", " ", 
     "at", " ", "a", " ", "fixed", " ", "solar", " ", 
     RowBox[{"time", ".", "This"}], " ", "allows", " ", "visualizing", " ", 
     "the", " ", "geometry", " ", "of", " ", "a", " ", "single", " ", 
     "mirror", " ", "section", " ", "and", " ", "its", " ", "corresponding", 
     " ", "focal", " ", 
     RowBox[{"point", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"exampleProfile", "=", 
     RowBox[{"Show", "[", 
      RowBox[{
       RowBox[{"ParametricPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"xLocal", "[", 
            RowBox[{"t", ",", "10"}], "]"}], ",", 
           RowBox[{"zLocal", "[", 
            RowBox[{"t", ",", "10"}], "]"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", 
           RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", "Thick"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<x [m]\>\"", ",", "\"\<z [m]\>\""}], "}"}]}], ",", 
         RowBox[{
         "PlotLabel", "->", "\"\<Local parabolic mirror profile\>\""}], ",", 
         RowBox[{"LabelStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{"Black", ",", "Bold"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"fxLocal", "[", "10", "]"}], ",", 
            RowBox[{"fzLocal", "[", "10", "]"}]}], "}"}], "}"}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"{", 
           RowBox[{"Red", ",", 
            RowBox[{"PointSize", "[", "Large", "]"}]}], "}"}]}]}], "]"}]}], 
      "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9830282752193117`*^9, 3.983028284775783*^9}, 
   3.983028328488258*^9},ExpressionUUID->"92365be0-d2df-49d5-a104-\
d4df288d34d0"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Animation", " ", "of", " ", "the", " ", "daily", " ", "evolution", " ", 
    "of", " ", "the", " ", "parabolic", " ", "profile"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "This", " ", "animation", " ", "shows", " ", "how", " ", "the", " ", 
     "parabolic", " ", "profile", " ", "continuously", " ", "changes", " ", 
     "throughout", " ", "the", " ", 
     RowBox[{"day", ".", "As"}], " ", "the", " ", "solar", " ", "elevation", 
     " ", "increases", " ", 
     RowBox[{"(", 
      RowBox[{"morning", " ", "to", " ", "noon"}], ")"}]}], ",", 
    RowBox[{
    "the", " ", "parabola", " ", "tilts", " ", "upward", " ", "and", " ", 
     "its", " ", "focal", " ", "point", " ", 
     RowBox[{"rises", ".", "After"}], " ", "solar", " ", "noon"}], ",", 
    RowBox[{"the", " ", "process", " ", 
     RowBox[{"reverses", ":", 
      RowBox[{
       RowBox[{
       "the", " ", "parabola", " ", "descends", " ", "and", " ", "the", " ", 
        "focal", " ", "point", " ", 
        RowBox[{"lowers", ".", "This"}], " ", "dynamic", " ", "behavior", " ",
         "is", " ", "the", " ", "basis", " ", "for", " ", "constructing", " ",
         "the", " ", "full", " ", "mirror", " ", "surface", " ", "as", " ", 
        "an", " ", "envelope", " ", "of", " ", "time"}], "-", 
       RowBox[{"dependent", " ", "parabolic", " ", 
        RowBox[{"sections", "."}]}]}]}]}]}], "*)"}], 
  RowBox[{"Animate", "[", 
   RowBox[{
    RowBox[{"Show", "[", 
     RowBox[{
      RowBox[{"ParametricPlot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xLocal", "[", 
           RowBox[{"t", ",", "TST"}], "]"}], ",", 
          RowBox[{"zLocal", "[", 
           RowBox[{"t", ",", "TST"}], "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", 
          RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
        RowBox[{"PlotStyle", "->", "Thick"}], ",", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
