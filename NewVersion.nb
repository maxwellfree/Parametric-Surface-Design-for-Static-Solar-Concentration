Cell[CellGroupData[{
Cell["Solar geometry : latitude, day angle and solar declination", "Title",
 CellChangeTimes->{{3.983027396523788*^9, 
  3.983027404613921*^9}},ExpressionUUID->"040a33e1-ead7-4a52-b024-\
c4daa682bcbf"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Definition", " ", "of", " ", "site", " ", "latitude"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Site", " ", "latitude", " ", "in", " ", 
    RowBox[{"radians", ".", "The"}], " ", "reference", " ", "location", " ", 
    "considered", " ", "in", " ", "this", " ", "model", " ", "is", " ", "set",
     " ", "to", " ", "37", " ", "degrees", " ", 
    RowBox[{"north", ".", "This"}], " ", "parameter", " ", "defines", " ", 
    "the", " ", "observer", " ", "position", " ", "on", " ", "Earth", " ", 
    "and", " ", "directly", " ", "affects", " ", "the", " ", "solar", " ", 
    "trajectory", " ", "and", " ", "all", " ", "derived", " ", "solar", " ", 
    RowBox[{"angles", "."}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"latitude", "=", 
     RowBox[{"37", " ", "Degree"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Day", " ", "angle", " ", "and", " ", "solar", " ", "declination", " ", 
     RowBox[{"(", 
      RowBox[{"Spencer", " ", "model"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Daily", " ", "angle", " ", "beta", 
      RowBox[{"(", "dn", ")"}]}], ",", 
     RowBox[{"also", " ", "known", " ", "as", " ", "the", " ", "day", " ", 
      RowBox[{"angle", ".", "This"}], " ", "variable", " ", "maps", " ", 
      "the", " ", "day", " ", "of", " ", "the", " ", "year", " ", 
      RowBox[{"(", "dn", ")"}], " ", "into", " ", "a", " ", "periodic", " ", 
      "angular", " ", "scale"}], ",", 
     RowBox[{"representing", " ", "the", " ", 
      RowBox[{"Earth", "'"}], "s", " ", "orbit", " ", "around", " ", "the", 
      " ", 
      RowBox[{"Sun", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"beta", "[", "dn_", "]"}], ":=", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"dn", "-", "1"}], ")"}], "/", "365"}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Solar", " ", "declination", " ", "delta", 
       RowBox[{"(", "dn", ")"}], " ", "computed", " ", "using", " ", 
       RowBox[{"Spencer", "'"}], "s", " ", "Fourier"}], "-", 
      RowBox[{"series", " ", 
       RowBox[{"approximation", ".", "This"}], " ", "analytical", " ", 
       "expression", " ", "provides", " ", "a", " ", "high"}], "-", 
      RowBox[{
      "accuracy", " ", "representation", " ", "of", " ", "the", " ", 
       "seasonal", " ", "variation", " ", "of", " ", "the", " ", "solar", " ",
        "declination", " ", 
       RowBox[{"angle", ".", "The"}], " ", "declination", " ", "angle", " ", 
       "defines", " ", "the", " ", "tilt", " ", "between", " ", "the", " ", 
       RowBox[{"Earth", "'"}], "s", " ", "equatorial", " ", "plane", " ", 
       "and", " ", "the", " ", "Sun"}], "-", 
      RowBox[{"Earth", " ", "direction"}]}], ",", 
     RowBox[{
     "and", " ", "it", " ", "is", " ", "a", " ", "key", " ", "input", " ", 
      "for", " ", "computing", " ", "solar", " ", "elevation", " ", "and", 
      " ", "azimuth", " ", 
      RowBox[{"angles", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"delta", "[", "dn_", "]"}], ":=", 
     RowBox[{"0.006918", "-", 
      RowBox[{"0.399912", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"beta", "[", "dn", "]"}], "]"}]}], "+", 
      RowBox[{"0.070257", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"beta", "[", "dn", "]"}], "]"}]}], "-", 
      RowBox[{"0.006758", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", " ", 
         RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}], "+", 
      RowBox[{"0.000907", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"2", " ", 
         RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}], "-", 
      RowBox[{"0.002697", " ", 
       RowBox[{"Cos", "[", 
        RowBox[{"3", " ", 
         RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}], "+", 
      RowBox[{"0.00148", " ", 
       RowBox[{"Sin", "[", 
        RowBox[{"3", " ", 
         RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}]}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Visualization", " ", "of", " ", "solar", " ", "declination", " ", 
      "over", " ", "the", " ", 
      RowBox[{"year", ".", "This"}], " ", "plot", " ", "illustrates", " ", 
      "the", " ", "seasonal", " ", "variation", " ", "of", " ", "the", " ", 
      "declination", " ", "angle"}], ",", 
     RowBox[{
      RowBox[{"ranging", " ", "approximately", " ", "between"}], "-", 
      RowBox[{"23.44", "\[Degree]", " ", "and"}], "+", 
      RowBox[{"23.44", 
       RowBox[{"\[Degree]", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"delta", "[", "dd", "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"dd", ",", "1", ",", "365"}], "}"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Day of year (dn)\>\"", ",", "\"\<\[Delta] [rad]\>\""}], 
       "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Marketing\>\""}], ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "Bold", ",", "Large"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
