   RowBox[{"FacadeLength", "=", "30"}], ";"}]}]], "Input",
 CellChangeTimes->{{3.983028616877625*^9, 3.983028616878066*^9}},
 CellLabel->"In[73]:=",ExpressionUUID->"de168084-d921-4ed1-b13c-29fba14c17f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Generation of the mirror surface and focal trajectory for selected days\
\>", "Section",
 CellChangeTimes->{{3.9830287238948383`*^9, 3.983028727121586*^9}, 
   3.9830297239073143`*^9},ExpressionUUID->"838d60bb-13f4-49c3-a341-\
18c384b60ec6"],

Cell[CellGroupData[{

Cell["\<\
This block defines a reusable function that generates both the mirror surface \
and the associated focal trajectory for any selected day of the year.The \
construction is performed by sweeping the true solar time over the operating \
interval.For each solar time:-a local parabolic section is generated in the \
xz-plane,-the corresponding focal point is computed,-both are rotated \
according to the geometric azimuth,-and translated along the horizontal solar \
sweep.The output is stored as an association with two \
components:\"Surface\",containing the collection of transformed parabolic \
sections,and \"Focus\",containing the corresponding transformed focal \
points.This modular construction makes it possible to compare mirror \
geometries generated for different days under identical sampling conditions.\
\>", "Subsubsection",
 CellChangeTimes->{{3.983029736353767*^9, 
  3.9830297468212214`*^9}},ExpressionUUID->"0683126f-a1de-4adc-b0eb-\
8e49fd8c237e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Reusable", " ", "generator", " ", "for", " ", "the", " ", "mirror", " ", 
    "surface", " ", "and", " ", "focal", " ", "trajectory"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"GenerateSurfaceAndFocus", "[", "dn", "]"}], " ", "constructs", 
     " ", "the", " ", "mirror", " ", "surface", " ", "and", " ", "the", " ", 
     "corresponding", " ", "focal", " ", "trajectory", " ", "for", " ", "a", 
     " ", "given", " ", "day", " ", "of", " ", "the", " ", 
     RowBox[{"year", ".", 
      RowBox[{"Input", ":", 
       RowBox[{"-", "dn"}], ":", 
       RowBox[{
       "day", " ", "number", " ", "of", " ", "the", " ", "year", " ", 
        RowBox[{"Output", ":", 
         RowBox[{
          RowBox[{"-", "an"}], " ", "association", " ", "with", " ", "two", 
          " ", "entries"}], ":", "\"\<Surface\>\""}]}]}]}]}], "->", 
    RowBox[{
     RowBox[{
     "collection", " ", "of", " ", "transformed", " ", "parabolic", " ", 
      "sections", " ", "\"\<Focus\>\""}], "->", 
     RowBox[{
     "collection", " ", "of", " ", "transformed", " ", "focal", " ", 
      "points"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"GenerateSurfaceAndFocus", "[", "dn_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"j", "=", "0"}], ",", "yNormLocal", ",", "data", ",", 
        "focus"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Normalization", " ", "factor", " ", "for", " ", "the", " ", "lateral",
         " ", "displacement", " ", "over", " ", "the", " ", "full", " ", 
        "operating", " ", "interval", " ", "of", " ", "the", " ", "selected", 
        " ", 
        RowBox[{"day", ".", "This"}], " ", "ensures", " ", "that", " ", "the",
         " ", "horizontal", " ", "sweep", " ", "is", " ", "consistently", " ", 
        RowBox[{"scaled", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"yNormLocal", "=", 
        RowBox[{"Max", "[", 
         RowBox[{"Abs", "@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"y", "[", 
             RowBox[{"dn", ",", "TST"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"TST", ",", 
              RowBox[{"12", "-", "3"}], ",", 
              RowBox[{"12", "+", "3"}], ",", "0.01"}], "}"}]}], "]"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Sweep", " ", "the", " ", "true", " ", "solar", " ", "time", " ", 
         "over", " ", "the", " ", "selected", " ", "operating", " ", 
         RowBox[{"window", "."}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"TST", "=", 
          RowBox[{"12", "-", "3"}]}], ",", 
         RowBox[{"TST", "<=", 
          RowBox[{"12", "+", "3"}]}], ",", 
         RowBox[{"TST", "+=", "0.05"}], ",", 
         RowBox[{
          RowBox[{"j", "=", 
           RowBox[{"j", "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Initialize", " ", "storage", " ", "for", " ", "the", " ", 
            "current", " ", "parabolic", " ", "section", " ", "and", " ", 
            "focal", " ", 
            RowBox[{"point", "."}]}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"data", "[", "j", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"focus", "[", "j", "]"}], "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Generate", " ", "the", " ", "local", " ", "parabolic", " ", 
             "profile", " ", "in", " ", "the", " ", "xz"}], "-", 
            RowBox[{
            "plane", " ", "by", " ", "sweeping", " ", "the", " ", "parabola", 
             " ", "parameter", " ", 
             RowBox[{"t", "."}]}]}], "*)"}], 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"i", "=", 
             RowBox[{"-", "600"}]}], ",", 
            RowBox[{"i", "<=", "600"}], ",", 
            RowBox[{"i", "++"}], ",", 
            RowBox[{
             RowBox[{"t", "=", 
              RowBox[{"i", "/", "200"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"data", "[", "j", "]"}], "=", 
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{"data", "[", "j", "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"xref", "[", 
                   RowBox[{"dn", ",", "TST", ",", "t"}], "]"}], ",", "0", ",", 
                  RowBox[{"zref", "[", 
                   RowBox[{"dn", ",", "TST", ",", "t"}], "]"}]}], "}"}]}], 
               "]"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Local", " ", "focal", " ", "point", " ", "before", " ", "the", 
            " ", "rigid", " ", 
            RowBox[{"transformation", "."}]}], "*)"}], "\[IndentingNewLine]", 
          
          RowBox[{
           RowBox[{"focus", "[", "j", "]"}], "=", 
           RowBox[{"{", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"fx", "[", 
               RowBox[{"dn", ",", "TST"}], "]"}], ",", "0", ",", 
              RowBox[{"fz", "[", 
               RowBox[{"dn", ",", "TST"}], "]"}]}], "}"}], "}"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Apply", " ", "the", " ", "rigid", " ", "transformation", " ", 
             "to", " ", "the", " ", "focal", " ", 
             RowBox[{"point", ":", 
              RowBox[{
               RowBox[{"-", "rotation"}], " ", "by", " ", "the", " ", 
               "opposite", " ", "of", " ", "the", " ", "geometric", " ", 
               "azimuth"}]}]}], ",", 
            RowBox[{
             RowBox[{"-", "translation"}], " ", "along", " ", "the", " ", 
             "horizontal", " ", "solar", " ", 
             RowBox[{"trajectory", "."}]}]}], "*)"}], 
          RowBox[{
           RowBox[{"focus", "[", "j", "]"}], "=", 
           RowBox[{"TransformCurve", "[", 
            RowBox[{
             RowBox[{"focus", "[", "j", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"azimuth", "[", 
               RowBox[{"dn", ",", "TST"}], "]"}]}], ",", 
             RowBox[{"x", "[", 
              RowBox[{"dn", ",", "TST"}], "]"}], ",", 
             RowBox[{
              RowBox[{"FacadeLength", "/", "2"}], "*", 
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"dn", ",", "TST"}], "]"}], "/", "yNormLocal"}]}]}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "Apply", " ", "the", " ", "same", " ", "rigid", " ", 
            "transformation", " ", "to", " ", "the", " ", "full", " ", 
            "parabolic", " ", 
            RowBox[{"section", "."}]}], "*)"}], 
          RowBox[{
           RowBox[{"data", "[", "j", "]"}], "=", 
           RowBox[{"TransformCurve", "[", 
            RowBox[{
             RowBox[{"data", "[", "j", "]"}], ",", 
             RowBox[{"-", 
              RowBox[{"azimuth", "[", 
               RowBox[{"dn", ",", "TST"}], "]"}]}], ",", 
             RowBox[{"x", "[", 
              RowBox[{"dn", ",", "TST"}], "]"}], ",", 
             RowBox[{
              RowBox[{"FacadeLength", "/", "2"}], "*", 
              RowBox[{
               RowBox[{"y", "[", 
                RowBox[{"dn", ",", "TST"}], "]"}], "/", "yNormLocal"}]}]}], 
            "]"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Return", " ", "both", " ", "the", " ", "mirror", " ", "surface", " ",
          "and", " ", "the", " ", "focal", " ", "trajectory", " ", "as", " ", 
         "an", " ", 
         RowBox[{"association", "."}]}], "*)"}], 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Surface\>\"", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"data", "[", "k", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", "j"}], "}"}]}], "]"}]}], ",", 
         RowBox[{"\"\<Focus\>\"", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"focus", "[", "k", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"k", ",", "1", ",", "j"}], "}"}]}], "]"}]}]}], 
        "|>"}]}]}], "]"}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.9830297623170757`*^9, 
  3.9830297803102007`*^9}},ExpressionUUID->"bb4482b2-cad5-4716-8fe8-\
8d93e5693e99"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Generation", " ", "of", " ", "mirror", " ", "surfaces", " ", "for", " ", 
    "two", " ", "representative", " ", "summer", " ", "days"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Two", " ", "representative", " ", "summer", " ", "days", " ", "are", " ", 
    "considered", " ", "in", " ", "order", " ", "to", " ", "compare", " ", 
    "the", " ", "resulting", " ", "mirror", " ", "geometries", " ", "and", 
    " ", "focal", " ", 
    RowBox[{"trajectories", ".", "Day"}], " ", "170", " ", "is", " ", "used", 
    " ", "as", " ", "a", " ", "reference", " ", "summer", " ", 
    RowBox[{"day", ".", "Day"}], " ", "176", " ", "is", " ", "introduced", 
    " ", "as", " ", "a", " ", "nearby", " ", "operating", " ", "day", " ", 
    "to", " ", "evaluate", " ", "whether", " ", "the", " ", "mirror", " ", 
    "geometry", " ", "remains", " ", "practically", " ", "unchanged", " ", 
    "within", " ", "the", " ", "selected", " ", "summer", " ", 
    RowBox[{"interval", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"day170", "=", 
     RowBox[{"GenerateSurfaceAndFocus", "[", "170", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"day176", "=", 
     RowBox[{"GenerateSurfaceAndFocus", "[", "176", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983029798065893*^9, 
  3.983029798066332*^9}},ExpressionUUID->"222961c1-b7a4-4373-adf5-\
b7268b7df5c9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Extraction", " ", "of", " ", "surfaces", " ", "and", " ", "focal", " ", 
    "trajectories"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Mirror", " ", "surface", " ", "and", " ", "focal", " ", "trajectory", " ",
     "for", " ", "day", " ", "170."}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SurfacesDay170", "=", 
     RowBox[{"day170", "[", "\"\<Surface\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ReactorDay170", "=", 
     RowBox[{"day170", "[", "\"\<Focus\>\"", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Mirror", " ", "surface", " ", "and", " ", "focal", " ", "trajectory", 
     " ", "for", " ", "day", " ", "176."}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SurfacesDay176", "=", 
     RowBox[{"day176", "[", "\"\<Surface\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ReactorDay176", "=", 
     RowBox[{"day176", "[", "\"\<Focus\>\"", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983029824405785*^9, 
  3.983029824406075*^9}},ExpressionUUID->"b06fa1dd-0601-4ccc-96b7-\
b7c830953ae8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
At this stage, the mirror surface is represented as a discrete set of \
transformed parabolic sections . In later steps, this point cloud can be \
visualized, interpolated, or exported for fabrication and simulation .\
\>", "Subsubsection",
 CellChangeTimes->{{3.983028790568046*^9, 
  3.9830288035641937`*^9}},ExpressionUUID->"e1162dd3-c393-4078-a2e4-\
36aab691680b"],

