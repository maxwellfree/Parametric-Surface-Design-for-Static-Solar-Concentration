Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Distances", " ", "section", " ", "by", " ", "section"}], ",", 
    RowBox[{"one", " ", "value", " ", "per", " ", "TST"}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"sectionErrors", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Mean", "[", 
        RowBox[{"MapThread", "[", 
         RowBox[{"EuclideanDistance", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"SurfacesDay170", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", 
            RowBox[{"SurfacesDay176", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"k", ",", "1", ",", 
         RowBox[{"Length", "[", "SurfacesDay170", "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tstValues", "=", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"12", "-", "3"}], ",", 
       RowBox[{"12", "+", "3"}], ",", "0.05"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{"tstValues", ",", "sectionErrors"}], "}"}], "]"}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
       "\"\<True solar time [h]\>\"", ",", 
        "\"\<Mean section distance [m]\>\""}], "}"}]}], ",", 
     RowBox[{
     "PlotLabel", "->", 
