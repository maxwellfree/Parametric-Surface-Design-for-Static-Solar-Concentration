Cell[CellGroupData[{

Cell["Horizontal projection", "Title",
 CellChangeTimes->{{3.983027904830419*^9, 
  3.983027914627987*^9}},ExpressionUUID->"da618fd1-48fb-49ab-a868-\
35c9b7b31aff"],

Cell[CellGroupData[{

Cell["\<\
This block computes the horizontal projection of the solar direction for a \
selected day . The resulting curve represents the solar sweep in the xy - \
plane using the geometric convention adopted in this model . In this \
convention, the azimuth is not expressed in the standard astronomical \
reference frame, but as a signed geometric angle measured from the positive x \
- axis in the counterclockwise direction . This definition is the one used \
later to generate the parabolic sections and the three - dimensional mirror \
surface .\
\>", "Subsection",
 CellChangeTimes->{
  3.983028314791648*^9},ExpressionUUID->"69e2502d-8906-4632-b5f9-\
f1204abf7929"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "Horizontal", " ", "projection", " ", "of", " ", "the", " ", "solar", " ", 
    "direction"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"Horizontal", " ", "x"}], "-", 
     RowBox[{"component", " ", "of", " ", "the", " ", "solar", " ", 
      RowBox[{"direction", ".", 
       RowBox[{"Cos", "[", "h", "]"}]}], " ", "gives", " ", "the", " ", 
      "magnitude", " ", "of", " ", "the", " ", "horizontal", " ", 
      "projection"}]}], ",", 
    RowBox[{
     RowBox[{"while", " ", 
      RowBox[{"Cos", "[", "azimuth", "]"}], " ", "gives", " ", "its", " ", 
      "component", " ", "along", " ", "the", " ", "x"}], "-", 
     RowBox[{"axis", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"x", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"azimuth", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Horizontal", " ", "y"}], "-", 
      RowBox[{"component", " ", "of", " ", "the", " ", "solar", " ", 
       RowBox[{"direction", ".", 
        RowBox[{"Cos", "[", "h", "]"}]}], " ", "gives", " ", "the", " ", 
       "magnitude", " ", "of", " ", "the", " ", "horizontal", " ", 
       "projection"}]}], ",", 
     RowBox[{
      RowBox[{"while", " ", 
       RowBox[{"Sin", "[", "azimuth", "]"}], " ", "gives", " ", "its", " ", 
       "component", " ", "along", " ", "the", " ", "y"}], "-", 
      RowBox[{"axis", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"y", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{"h", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"azimuth", "[", 
        RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Example", " ", "of", " ", "daily", " ", "horizontal", " ", "sweep"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Example", " ", "day", " ", "and", " ", "facade", " ", "length", " ", 
     "used", " ", "for", " ", 
     RowBox[{"visualization", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dn", "=", "170"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"FacadeLength", "=", "30"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Normalization", " ", "factor", " ", "for", " ", "the", " ", "lateral", 
     " ", "excursion", " ", "over", " ", "the", " ", "selected", " ", "time", 
     " ", 
     RowBox[{"interval", ".", "This"}], " ", "avoids", " ", "using", " ", "a",
      " ", "single", " ", "endpoint", " ", "as", " ", "reference", " ", "and",
      " ", "keeps", " ", "the", " ", "sweep", " ", "scaled", " ", "to", " ", 
     "the", " ", "facade", " ", 
     RowBox[{"width", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"yNorm", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"Abs", "@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"dn", ",", "hora"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"hora", ",", 
           RowBox[{"12", "-", "3"}], ",", 
           RowBox[{"12", "+", "3"}], ",", "0.01"}], "}"}]}], "]"}]}], "]"}]}],
     ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Daily", " ", "horizontal", " ", "solar", " ", "sweep", " ", "in", " ", 
       "the", " ", "adopted", " ", "geometric", " ", 
       RowBox[{"convention", ".", "The"}], " ", "x"}], "-", 
      RowBox[{
      "component", " ", "is", " ", "kept", " ", "in", " ", "its", " ", 
       "natural", " ", "normalized", " ", "form"}]}], ",", 
     RowBox[{
      RowBox[{"whereas", " ", "the", " ", "y"}], "-", 
      RowBox[{
      "component", " ", "is", " ", "scaled", " ", "to", " ", "the", " ", 
       "facade", " ", "width", " ", "in", " ", "order", " ", "to", " ", 
       "visualize", " ", "the", " ", "region", " ", "where", " ", "the", " ", 
       "distributed", " ", "reactor", " ", "is", " ", 
       RowBox[{"placed", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dataXY", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"x", "[", 
          RowBox[{"dn", ",", "hora"}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"FacadeLength", "/", "2"}], ")"}], " ", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"dn", ",", "hora"}], "]"}], "/", "yNorm"}]}], ",", "0"}], 
        "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"hora", ",", 
         RowBox[{"12", "-", "3"}], ",", 
         RowBox[{"12", "+", "3"}], ",", "0.01"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "3", "D", " ", "visualization", " ", "of", " ", "the", " ", 
       "horizontal", " ", "solar", " ", 
       RowBox[{"path", ".", "Although"}], " ", "the", " ", "curve", " ", 
       "lies", " ", "in", " ", "the", " ", "plane", " ", "z"}], "=", "0"}], 
     ",", 
     RowBox[{
     "ListPointPlot3D", " ", "is", " ", "used", " ", "to", " ", "maintain", 
      " ", "consistency", " ", "with", " ", "the", " ", "later", " ", "3", 
      "D", " ", "representation", " ", "of", " ", "the", " ", "mirror", " ", 
      "surface", " ", "and", " ", "focal", " ", 
      RowBox[{"trajectory", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"horizontalSweep", "=", 
    RowBox[{"ListPointPlot3D", "[", 
     RowBox[{"dataXY", ",", 
      RowBox[{"AxesLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x [m]\>\"", ",", "\"\<y [m]\>\"", ",", "\"\<z [m]\>\""}],
         "}"}]}], ",", 
      RowBox[{
      "PlotLabel", "->", 
       "\"\<Horizontal solar sweep in the model reference frame\>\""}], ",", 
      RowBox[{"PlotTheme", "->", "\"\<Marketing\>\""}], ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
      RowBox[{"AspectRatio", "->", "1"}]}], "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.983027930871683*^9, 3.983027936684876*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"e35e501b-e06c-4101-8f47-d0f3db75808f"],

