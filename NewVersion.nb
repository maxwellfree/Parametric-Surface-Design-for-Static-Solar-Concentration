Cell[CellGroupData[{

Cell["Solar time and solar angles", "Title",
 CellChangeTimes->{{3.983027655431221*^9, 
  3.983027659945898*^9}},ExpressionUUID->"d369b091-c060-46ec-9073-\
a62d40c86448"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"::", "Subsection", "::"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{"Hour", " ", "angle", " ", "and", " ", "solar", " ", "time"}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Hour", " ", "angle", " ", "H", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "radians"}], ")"}], " ", "computed", " ", "from", 
     " ", "the", " ", "true", " ", "solar", " ", "time", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"TST", ",", 
        RowBox[{"in", " ", "hours"}]}], ")"}], ".", "The"}], " ", "hour", " ",
      "angle", " ", "represents", " ", "the", " ", "angular", " ", 
     "displacement", " ", "of", " ", "the", " ", "Sun", " ", "with", " ", 
     "respect", " ", "to", " ", "the", " ", "local", " ", 
     RowBox[{"meridian", ".", "It"}], " ", "is", " ", "zero", " ", "at", " ", 
     "solar", " ", "noon"}], ",", 
    RowBox[{"negative", " ", "in", " ", "the", " ", "morning"}], ",", 
    RowBox[{"and", " ", "positive", " ", "in", " ", "the", " ", 
     RowBox[{"afternoon", ".", "The"}], " ", "factor", " ", "15", "\[Degree]",
      " ", "per", " ", "hour", " ", "corresponds", " ", "to", " ", "the", " ", 
     RowBox[{"Earth", "'"}], "s", " ", "rotation", " ", 
     RowBox[{"rate", ".", "Subtracting"}], " ", "12", " ", "centers", " ", 
     "the", " ", "system", " ", "at", " ", "solar", " ", 
     RowBox[{"noon", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"timeH", "[", "TST_", "]"}], ":=", 
     RowBox[{"15", " ", "Degree", " ", 
      RowBox[{"(", 
       RowBox[{"TST", "-", "12"}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Solar", " ", "elevation", " ", "and", " ", "zenith", " ", "angles"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solar", " ", "zenith", " ", "angle", " ", "Z", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"in", " ", "radians"}], ")"}], ".", "This"}], " ", "is", " ", 
     "the", " ", "angle", " ", "between", " ", "the", " ", "local", " ", 
     "vertical", " ", "direction", " ", "and", " ", "the", " ", "solar", " ", 
     
     RowBox[{"direction", ".", 
      RowBox[{"Note", ":", 
       RowBox[{
       "This", " ", "angle", " ", "is", " ", "NOT", " ", "the", " ", "solar", 
        " ", 
        RowBox[{"azimuth", "."}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"zenith", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{"ArcCos", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "latitude", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"delta", "[", "dn", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"Cos", "[", "latitude", "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"timeH", "[", "TST", "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Solar", " ", "elevation", " ", "angle", " ", "h", " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"in", " ", "radians"}], ")"}], ".", "This"}], " ", "is", " ", 
     "the", " ", "angle", " ", "between", " ", "the", " ", "solar", " ", 
     "direction", " ", "and", " ", "the", " ", "horizontal", " ", 
     RowBox[{"plane", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"h", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{"ArcSin", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Sin", "[", "latitude", "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"delta", "[", "dn", "]"}], "]"}]}], "+", 
       RowBox[{
        RowBox[{"Cos", "[", "latitude", "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
        RowBox[{"Cos", "[", 
         RowBox[{"timeH", "[", "TST", "]"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Geometric", " ", "solar", " ", "azimuth", " ", 
     RowBox[{"(", 
      RowBox[{"model", " ", "convention"}], ")"}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
      "Solar", " ", "azimuth", " ", "in", " ", "the", " ", "geometric", " ", 
       "convention", " ", "adopted", " ", "for", " ", "the", " ", "mirror", 
       " ", 
       RowBox[{"model", ".", "This"}], " ", "is", " ", "a", " ", "signed", 
       " ", "angle", " ", "in", " ", "the", " ", "horizontal", " ", "xy"}], 
      "-", 
      RowBox[{"plane", ":", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "measured"}], " ", "from", " ", "the", " ", "positive", 
         " ", "x"}], "-", "axis", "-", "counterclockwise", "-", 
        RowBox[{"negative", " ", "in", " ", "the", " ", "morning"}]}]}]}], 
     ",", 
     RowBox[{
     "positive", " ", "in", " ", "the", " ", "afternoon", " ", "This", " ", 
      "definition", " ", "differs", " ", "from", " ", "standard", " ", 
      "solar", " ", "azimuth", " ", "formulations"}], ",", 
     RowBox[{
     "but", " ", "preserves", " ", "continuity", " ", "and", " ", "is", " ", 
      "consistent", " ", "with", " ", "the", " ", "geometric", " ", 
      "construction", " ", "of", " ", "the", " ", "mirror", " ", 
      RowBox[{"surface", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"azimuth", "[", 
      RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sx", ",", "sy"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Horizontal", " ", "projection", " ", "of", " ", "the", " ", "solar", 
         " ", "direction"}], "*)"}], 
       RowBox[{
        RowBox[{"sx", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "latitude", "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"timeH", "[", "TST", "]"}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"Cos", "[", "latitude", "]"}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"delta", "[", "dn", "]"}], "]"}]}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sy", "=", 
         RowBox[{
          RowBox[{"Cos", "[", 
           RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"timeH", "[", "TST", "]"}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Quadrant", "-", 
          RowBox[{"aware", " ", "angle"}]}], "*)"}], 
        RowBox[{"ArcTan", "[", 
         RowBox[{"sx", ",", "sy"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"::", "Subsection", "::"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Consistency", " ", "check"}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Example", " ", "day", " ", "for", " ", "validation"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dn", "=", "160"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"The", " ", "zenith", " ", "angle", " ", "must", " ", 
      RowBox[{"satisfy", ":", "zenith"}]}], "=", 
     RowBox[{
      RowBox[{"Pi", "/", "2"}], "-", "elevation"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"zenith", "[", 
        RowBox[{"dn", ",", "hora"}], "]"}], ",", 
       RowBox[{
        RowBox[{"Pi", "/", "2"}], "-", 
        RowBox[{"h", "[", 
         RowBox[{"dn", ",", "hora"}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"hora", ",", "9", ",", "15"}], "}"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<Solar time [h]\>\"", ",", "\"\<Angle [rad]\>\""}], 
       "}"}]}], ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"PlotTheme", "->", "\"\<Marketing\>\""}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<zenith\>\"", ",", "\"\<Pi/2 - elevation\>\""}], "}"}]}], 
     ",", 
     RowBox[{"LabelStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Black", ",", "Bold", ",", "Large"}], "]"}]}]}], 
    "]"}]}]}]], "Input",
 CellChangeTimes->{{3.983027695543538*^9, 
  3.98302771342034*^9}},ExpressionUUID->"250a2746-12be-4c1f-9f71-\
6337d5747aac"],

