Cell["\<\
FLUX FIELD ON THE REACTOR SKIN
reactorFluxField builds the total heat-flux field on the reactor skin for a \
given solar time TST.

Components:
\t-qReflected:flux from reflected rays
\t-qDirect:direct solar flux on the reactor
\t-qTotal:sum of both contributions\
\>", "Text",
 CellChangeTimes->{{3.983969449644627*^9, 
  3.983969468381094*^9}},ExpressionUUID->"c4a358cf-d19d-4f77-bcd9-\
f9295d3c746c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"reactorFluxField", "[", 
    RowBox[{"TST_", ",", 
     RowBox[{"curveStep_", ":", "4"}], ",", 
     RowBox[{"pointStep_", ":", "2"}], ",", 
     RowBox[{"nSGrid_", ":", "120"}], ",", 
     RowBox[{"nUGrid_", ":", "90"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"field", ",", "qReflected", ",", "qDirect", ",", "qTotal"}], 
      "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "field", " ", "comes", " ", "from", " ", "the", " ", "previous", " ", 
        "optical", " ", "block", " ", "and", " ", "contains", " ", "the", " ",
         "continuous", " ", "power"}], "-", 
       RowBox[{
       "density", " ", "map", " ", "on", " ", "the", " ", "reactor", " ", 
        RowBox[{"skin", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"field", "=", 
       RowBox[{"reactorPowerDensityField", "[", 
        RowBox[{
        "TST", ",", "curveStep", ",", "pointStep", ",", "nSGrid", ",", 
         "nUGrid"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Reflected", " ", "flux"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"qReflected", "=", 
       RowBox[{"field", "[", "\"\<Density\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Direct", " ", "flux"}], ",", 
        RowBox[{"taken", " ", "as", " ", "zero", " ", "here"}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"qDirect", "=", 
       RowBox[{"directFluxField", "[", 
        RowBox[{"TST", ",", 
         RowBox[{"Dimensions", "[", "qReflected", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Total", " ", "flux"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"qTotal", "=", 
       RowBox[{"qReflected", "+", "qDirect"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Flux\>\"", "\[Rule]", "qTotal"}], ",", 
        RowBox[{"\"\<sGrid\>\"", "\[Rule]", 
         RowBox[{"field", "[", "\"\<sGrid\>\"", "]"}]}], ",", 
        RowBox[{"\"\<uGrid\>\"", "\[Rule]", 
         RowBox[{"field", "[", "\"\<uGrid\>\"", "]"}]}]}], "|>"}]}]}], 
    "]"}]}], ";"}]], "Input",
 CellLabel->
  "In[179]:=",ExpressionUUID->"8593c63f-9098-4c4f-b5cd-570e5a1d208a"],

Cell["\<\
DISCRETE LAPLACIAN

Array-index convention for T:
\t-first index\[Rule]u (perimeter coordinate)
\t-second index\[Rule]s (longitudinal coordinate) 

Boundary conditions:
\t-periodic in u
\t-homogeneous Neumann in s (zero flux),implemented with mirror values at the \
ends.

This operator returns a finite-difference approximation of the 2D Laplacian \
of T.\
\>", "Text",
 CellChangeTimes->{{3.983969531724945*^9, 
  3.983969561580632*^9}},ExpressionUUID->"30e70ad9-a42e-460d-8ab6-\
cb934deb08db"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"discreteLaplacian", "[", 
    RowBox[{"T_", ",", "ds_", ",", "du_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "nU", ",", "nS", ",", "lap", ",", "iuP", ",", "iuM", ",", "isP", ",", 
       "isM", ",", "Tup", ",", "Tdown", ",", "Tright", ",", "Tleft"}], "}"}], 
     ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Mesh", " ", "dimensions"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nU", ",", "nS"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "T", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Initialize", " ", "Laplacian", " ", "matrix"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"lap", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{"0.0", ",", 
         RowBox[{"{", 
          RowBox[{"nU", ",", "nS"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Do", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Neighbor", " ", "indices", " ", "in", " ", "the", " ", "perimeter", 
          " ", "direction", " ", 
          RowBox[{"u", ".", "Since"}], " ", "the", " ", "condition", " ", 
          "is", " ", 
          RowBox[{"periodic", ":", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"-", "if"}], " ", "we", " ", "are", " ", "at", " ", "the",
             " ", "last", " ", "node"}]}]}], ",", 
         RowBox[{"the", " ", "next", " ", "is", " ", "the", " ", "first"}], 
         ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"-", "if"}], " ", "we", " ", "are", " ", "at", " ", "the", 
          " ", "first", " ", "node"}], ",", 
         RowBox[{"the", " ", "previous", " ", "is", " ", "the", " ", 
          RowBox[{"last", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"iuP", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"iu", "\[Equal]", "nU"}], ",", "1", ",", 
            RowBox[{"iu", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"iuM", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"iu", "\[Equal]", "1"}], ",", "nU", ",", 
            RowBox[{"iu", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Neighbor", " ", "indices", " ", "in", " ", "the", " ", 
            "longitudinal", " ", "direction", " ", 
            RowBox[{"s", ".", "\[IndentingNewLine]", "Zero"}], " ", "flux", 
            " ", "at", " ", "the", " ", "boundaries", " ", "is", " ", 
            "implemented", " ", "using", " ", "mirror", " ", 
            RowBox[{"values", ":", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"-", "at"}], " ", "the", " ", "right", " ", "end", " ",
                "use", " ", "nS"}], "-", "1"}]}]}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"-", "at"}], " ", "the", " ", "left", " ", "end", " ", 
            "use", " ", "2."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"isP", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"is", "\[Equal]", "nS"}], ",", 
            RowBox[{"nS", "-", "1"}], ",", 
            RowBox[{"is", "+", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"isM", "=", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"is", "\[Equal]", "1"}], ",", "2", ",", 
            RowBox[{"is", "-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Neighbor", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"Tup", "=", 
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"iuP", ",", "is"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Tdown", "=", 
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"iuM", ",", "is"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Tright", "=", 
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"iu", ",", "isP"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Tleft", "=", 
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"iu", ",", "isM"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Discrete", " ", 
           RowBox[{"Laplacian", ":", 
            RowBox[{
             RowBox[{"second", " ", "derivative", " ", "in", " ", "u"}], "+", 
             
             RowBox[{"second", " ", "derivative", " ", "in", " ", "s"}]}]}]}],
           "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"lap", "[", 
           RowBox[{"[", 
            RowBox[{"iu", ",", "is"}], "]"}], "]"}], "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Tup", "-", 
              RowBox[{"2", " ", 
               RowBox[{"T", "[", 
                RowBox[{"[", 
                 RowBox[{"iu", ",", "is"}], "]"}], "]"}]}], "+", "Tdown"}], 
             ")"}], "/", 
            RowBox[{"du", "^", "2"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"Tright", "-", 
              RowBox[{"2", " ", 
               RowBox[{"T", "[", 
                RowBox[{"[", 
                 RowBox[{"iu", ",", "is"}], "]"}], "]"}]}], "+", "Tleft"}], 
             ")"}], "/", 
            RowBox[{"ds", "^", "2"}]}]}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"iu", ",", "1", ",", "nU"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"is", ",", "1", ",", "nS"}], "}"}]}], "]"}], ";", 
      "\[IndentingNewLine]", "lap"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[180]:=",ExpressionUUID->"b8102f61-0394-4b31-85db-a96afed6e191"],

Cell["\<\
STEADY THERMAL SOLVER BY PSEUDO-TIME RELAXATION

This function solves the steady temperature field on the reactor skin by \
pseudo-time relaxation.

Main parameters:
\t-TST:solar time
\t-curveStep,pointStep:sampling of the optical problem
\t-nSGrid,nUGrid:thermal mesh resolution
\t-TinitC:initial temperature in \[Degree]C
\t-maxIter:maximum number of iterations
\t-tol:convergence tolerance\
\>", "Text",
 CellChangeTimes->{{3.983969620999383*^9, 
  3.983969657182645*^9}},ExpressionUUID->"6a9415f6-0c96-498a-8b3d-\
7e90b8214721"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"steadySkinTemperature", "[", 
    RowBox[{"TST_", ",", 
     RowBox[{"curveStep_", ":", "4"}], ",", 
     RowBox[{"pointStep_", ":", "2"}], ",", 
     RowBox[{"nSGrid_", ":", "120"}], ",", 
     RowBox[{"nUGrid_", ":", "90"}], ",", 
     RowBox[{"TinitC_", ":", "30"}], ",", 
     RowBox[{"maxIter_", ":", "20000"}], ",", 
     RowBox[{"tol_", ":", "1.*^-6"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "fluxData", ",", "q", ",", "sGrid", ",", "uGrid", ",", "ds", ",", "du", 
       ",", "dt", ",", "T", ",", "Tnew", ",", "lap", ",", "source", ",", 
       "losses", ",", 
       RowBox[{"residual", "=", "Infinity"}], ",", 
       RowBox[{"iter", "=", "0"}], ",", "dtStable"}], "}"}], ",", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Obtain", " ", "the", " ", "heat", " ", "flux", " ", "on", " ", "the", 
       " ", "skin"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"fluxData", "=", 
       RowBox[{"reactorFluxField", "[", 
        RowBox[{
        "TST", ",", "curveStep", ",", "pointStep", ",", "nSGrid", ",", 
         "nUGrid"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"q", "=", 
       RowBox[{"fluxData", "[", "\"\<Flux\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sGrid", "=", 
       RowBox[{"fluxData", "[", "\"\<sGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"uGrid", "=", 
       RowBox[{"fluxData", "[", "\"\<uGrid\>\"", "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Spatial", " ", "mesh", " ", "steps"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"ds", "=", 
       RowBox[{
        RowBox[{"sGrid", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"sGrid", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"du", "=", 
       RowBox[{
        RowBox[{"uGrid", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "-", 
        RowBox[{"uGrid", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Explicit", " ", "stability", " ", "estimate", " ", "for", " ", "the",
          " ", "diffusive", " ", 
         RowBox[{"term", ".", "This"}], " ", "is", " ", "a", " ", "CFL"}], 
        "-", 
        RowBox[{"type", " ", "bound", " ", "for", " ", "2", "D", " ", 
         RowBox[{"diffusion", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"dtStable", "=", 
       RowBox[{"0.45", "/", 
        RowBox[{"(", 
         RowBox[{"alphaSteel", "*", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"2", "/", 
             RowBox[{"ds", "^", "2"}]}], "+", 
            RowBox[{"2", "/", 
             RowBox[{"du", "^", "2"}]}]}], ")"}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"dt", "=", "dtStable"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Uniform", " ", "initial", " ", "field", " ", "in", " ", "Kelvin"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{"T", "=", 
       RowBox[{"ConstantArray", "[", 
        RowBox[{
         RowBox[{"TinitC", "+", "273.15"}], ",", 
         RowBox[{"Dimensions", "[", "q", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Iterative", " ", "relaxation", " ", 
        RowBox[{"loop", ":", 
         RowBox[{
         "continue", " ", "until", " ", "the", " ", "maximum", " ", "number", 
          " ", "of", " ", "iterations", " ", "is", " ", "reached", " ", "or", 
          " ", "the", " ", "residual", " ", "falls", " ", "below", " ", "the",
           " ", 
          RowBox[{"tolerance", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"While", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"iter", "<", "maxIter"}], "&&", 
         RowBox[{"residual", ">", "tol"}]}], ",", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Temperature", " ", "Laplacian"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"lap", "=", 
          RowBox[{"discreteLaplacian", "[", 
           RowBox[{"T", ",", "ds", ",", "du"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Surface", " ", 
           RowBox[{"losses", ":", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"-", "convection"}], "\[IndentingNewLine]", "-", 
             RowBox[{"thermal", " ", "radiation"}]}]}]}], "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{"losses", "=", 
          RowBox[{
           RowBox[{"hExt", "*", 
            RowBox[{"(", 
             RowBox[{"T", "-", "Tamb"}], ")"}]}], "+", 
           RowBox[{"epsSteel", "*", "sigmaSB", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"T", "^", "4"}], "-", 
              RowBox[{"Tamb", "^", "4"}]}], ")"}]}]}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Net", " ", "source", " ", "term", " ", "per", " ", "unit", " ", 
           RowBox[{"area", ":", 
            RowBox[{"optical", " ", "heating", " ", "minus", " ", 
             RowBox[{"losses", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"source", "=", 
          RowBox[{"q", "-", "losses"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
            RowBox[{"Explicit", " ", "pseudo"}], "-", 
            RowBox[{"time", " ", 
             RowBox[{"step", ":", "Tnew"}]}]}], "=", 
           RowBox[{"T", "+", 
            RowBox[{
             RowBox[{"dt", "[", 
              RowBox[{
               RowBox[{"alpha", " ", "Lap", 
                RowBox[{"(", "T", ")"}]}], "+", 
               RowBox[{"source", "/", 
                RowBox[{"(", 
                 RowBox[{"rho", " ", "cp", " ", "e"}], ")"}]}]}], "]"}], " ", 
             "where", " ", "e", " ", "is", " ", "the", " ", "wall", " ", 
             RowBox[{"thickness", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"Tnew", "=", 
          RowBox[{"T", "+", 
           RowBox[{"dt", "*", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"alphaSteel", "*", "lap"}], "+", 
              RowBox[{"source", "/", 
               RowBox[{"(", 
                RowBox[{
                "rhoSteelMass", "*", "cpSteel", "*", "steelThickness"}], 
                ")"}]}]}], ")"}]}]}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Maximum", " ", "residual", " ", "between", " ", "consecutive", " ",
            "iterations"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"residual", "=", 
          RowBox[{"Max", "[", 
           RowBox[{"Abs", "[", 
            RowBox[{"Tnew", "-", "T"}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Update", " ", "solution"}], "*)"}], "\[IndentingNewLine]", 
         
         RowBox[{"T", "=", "Tnew"}], ";", "\[IndentingNewLine]", 
         RowBox[{"iter", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Return", ":", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "skin"}], " ", "temperature", " ", "in", " ", "K", " ",
           "and", " ", "in", " ", "\[Degree]C"}], "\n", "-", 
         RowBox[{"applied", " ", "heat", " ", "flux"}], "\n", "-", 
         RowBox[{"s", " ", "and", " ", "u", " ", "grids"}], "\n", "-", 
         RowBox[{"number", " ", "of", " ", "iterations"}], "\n", "-", 
         RowBox[{"final", " ", "residual"}], "\n", "-", "pseudo", "-", 
         RowBox[{"time", " ", "step", " ", "used"}]}]}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<SkinTempK\>\"", "\[Rule]", "T"}], ",", 
        RowBox[{"\"\<SkinTempC\>\"", "\[Rule]", 
         RowBox[{"T", "-", "273.15"}]}], ",", 
        RowBox[{"\"\<Flux\>\"", "\[Rule]", "q"}], ",", 
        RowBox[{"\"\<sGrid\>\"", "\[Rule]", "sGrid"}], ",", 
        RowBox[{"\"\<uGrid\>\"", "\[Rule]", "uGrid"}], ",", 
        RowBox[{"\"\<Iterations\>\"", "\[Rule]", "iter"}], ",", 
        RowBox[{"\"\<Residual\>\"", "\[Rule]", "residual"}], ",", 
        RowBox[{"\"\<dt\>\"", "\[Rule]", "dt"}]}], "|>"}]}]}], "]"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.9839697308644037`*^9, 3.983969760400824*^9}},
 CellLabel->
  "In[181]:=",ExpressionUUID->"a95bb2eb-6725-48d5-b3f0-85b9ddd0a934"],

Cell["\<\
INNER WALL TEMPERATURE
Approximation of the reactor inner-wall temperature.A simple radial \
temperature drop across the thickness is used:
\tDeltaT=q e/k 

Therefore:
\tTinner=Tskin-q e/k 

Interpretation:if q heats the outer surface,the inner wall is estimated to be \
slightly colder depending on heat flux and steel conductivity.\
\>", "Text",
 CellChangeTimes->{{3.9839697018512506`*^9, 3.983969736718906*^9}, {
  3.9839697809294033`*^9, 
  3.9839698021347733`*^9}},ExpressionUUID->"ed9b35a5-c40e-4985-9d5f-\
e5dc01cb0ead"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"innerWallTemperatureField", "[", "thermalAssoc_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Tskin", ",", "q"}], "}"}], ",", 
      RowBox[{
       RowBox[{"Tskin", "=", 
        RowBox[{"thermalAssoc", "[", "\"\<SkinTempK\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"q", "=", 
        RowBox[{"thermalAssoc", "[", "\"\<Flux\>\"", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Tskin", "-", 
        RowBox[{"q", "*", 
         RowBox[{"steelThickness", "/", "kSteel"}]}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"--", 
    RowBox[{"--", 
