   RowBox[{
    RowBox[{
     RowBox[{"uniformityDataAtTSTPerturbed", "[", 
      RowBox[{"TST_", ",", 
       RowBox[{"rayLen_", ":", "3.0"}], ",", 
       RowBox[{"sigmaPos_", ":", "0.0"}], ",", 
       RowBox[{"sigmaNormal_", ":", "0.0"}], ",", 
       RowBox[{"sigmaSolar_", ":", "0.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "data", ",", "hitData", ",", "weights", ",", "hitPts", ",", "sCoords",
          ",", "binRule", ",", "binIndex", ",", "powerBins", ",", "qBins", 
         ",", "meanQ", ",", "stdQ", ",", "cvQ", ",", "uniformityIndex"}], 
        "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"rayTracingDataAtTSTPerturbed", "[", 
          RowBox[{
          "TST", ",", "rayLen", ",", "sigmaPos", ",", "sigmaNormal", ",", 
           "sigmaSolar"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hitData", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"TrueQ", "[", 
              RowBox[{"#", "[", "\"\<HitQ\>\"", "]"}], "]"}], "&&", 
             RowBox[{"validPointQ", "[", 
              RowBox[{"#", "[", "\"\<HitPoint\>\"", "]"}], "]"}]}], "&"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "hitData", "]"}], "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<TST\>\"", "->", "TST"}], ",", 
             RowBox[{"\"\<UniformityCV\>\"", "->", "Indeterminate"}], ",", 
             RowBox[{"\"\<UniformityIndex\>\"", "->", "Indeterminate"}]}], 
            "|>"}], "]"}]}], "\[IndentingNewLine]", "]"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"weights", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"rhoMirror", "*", 
             RowBox[{"#", "[", "\"\<Weight\>\"", "]"}]}], ")"}], "&"}], "/@", 
          "hitData"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hitPts", "=", 
         RowBox[{"hitData", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<HitPoint\>\""}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sCoords", "=", 
         RowBox[{"nearestArcCoordinate", "/@", "hitPts"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"binRule", "=", 
         RowBox[{"Thread", "[", 
          RowBox[{"binCenters", "->", 
           RowBox[{"Range", "[", "nBinsUniformity", "]"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"binIndex", "=", 
         RowBox[{"First", "/@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Nearest", "[", 
              RowBox[{"binRule", ",", "#"}], "]"}], "&"}], "/@", "sCoords"}], 
           ")"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"powerBins", "=", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0.0", ",", "nBinsUniformity"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"powerBins", "[", 
            RowBox[{"[", 
             RowBox[{"binIndex", "[", 
              RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "+=", 
           RowBox[{"weights", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", 
            RowBox[{"Length", "[", "weights", "]"}]}], "}"}]}], 
         "\[IndentingNewLine]", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"qBins", "=", 
         RowBox[{"N", "[", 
          RowBox[{"powerBins", "/", "binAreas"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"meanQ", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Mean", "[", "qBins", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"stdQ", "=", 
         RowBox[{"N", "[", 
          RowBox[{"StandardDeviation", "[", "qBins", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"cvQ", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "meanQ", "]"}], "&&", 
            RowBox[{"meanQ", ">", "0"}]}], ",", 
           RowBox[{"N", "[", 
            RowBox[{"stdQ", "/", "meanQ"}], "]"}], ",", "Indeterminate"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"uniformityIndex", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"NumericQ", "[", "meanQ", "]"}], "&&", 
            RowBox[{"meanQ", ">", "0"}]}], ",", 
           RowBox[{"N", "[", 
            RowBox[{"1", "-", 
             RowBox[{"stdQ", "/", "meanQ"}]}], "]"}], ",", "Indeterminate"}], 
          "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TST\>\"", "->", "TST"}], ",", 
          RowBox[{"\"\<UniformityCV\>\"", "->", "cvQ"}], ",", 
          RowBox[{"\"\<UniformityIndex\>\"", "->", "uniformityIndex"}]}], 
