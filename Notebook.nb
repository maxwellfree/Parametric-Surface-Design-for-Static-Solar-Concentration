Cell["\<\
Definition of the operating interval

The range of true solar time (TST) over which the focal trajectory is \
analyzed is defined as:
\t-start:9 h
\t-end:15 h
\t-step:0.01 h 
\t
Since 0.01 h=0.6 min=36 s,a relatively fine temporal discretization is used.\
\>", "Text",
 CellChangeTimes->{{3.983962458810913*^9, 
  3.98396249061171*^9}},ExpressionUUID->"ecb6190d-1b77-4743-8b7c-\
a7436171e52d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tstMin", "=", "9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"tstMax", "=", "15"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"tstStep", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Time", " ", 
    RowBox[{"grid", ":", 
     RowBox[{
     "list", " ", "of", " ", "all", " ", "TST", " ", "values", " ", "within", 
      " ", "the", " ", "operating", " ", "interval"}]}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"tstGrid", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"tstMin", ",", "tstMax", ",", "tstStep"}], "]"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[93]:=",ExpressionUUID->"2afd7e95-5a86-4ab4-a1c4-2ab60c17fb6c"],

Cell["\<\
Focal trajectory in the local x\[Dash]z plane for day 170

For each TST value in the time grid,the focal position in the local x\[Dash]z \
plane is computed. It is assumed that:
\t-fxLocal[TST] gives the x-coordinate of the focus
\t-fzLocal[TST] gives the z-coordinate of the focus 

The result focalPath170 is a list of pairs:{{x1,z1},{x2,z2},...,{xn,zn}} \
describing the full focal trajectory during the day.\
\>", "Text",
 CellChangeTimes->{{3.98396258703856*^9, 
  3.983962612899819*^9}},ExpressionUUID->"d85d2810-3223-4f65-a8e1-\
5244d2145993"],

Cell[BoxData[
 RowBox[{
  RowBox[{"focalPath170", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"fxLocal", "[", "TST", "]"}], ",", 
       RowBox[{"fzLocal", "[", "TST", "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"TST", ",", "tstGrid"}], "}"}]}], "]"}]}], ";"}]], "Input",
