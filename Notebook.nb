          RowBox[{"ViewPoint", "\[Rule]", 
           RowBox[{"viewChoice", "[", "viewMode", "]"}]}], ",", 
          RowBox[{"ViewProjection", "\[Rule]", "\"\<Orthographic\>\""}], ",", 
          
          RowBox[{"ImageSize", "\[Rule]", "1000"}]}], "\[IndentingNewLine]", 
         "]"}]}]}], "\[IndentingNewLine]", "]"}], ",", 
