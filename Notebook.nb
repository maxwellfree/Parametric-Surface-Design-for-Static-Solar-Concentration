}]}]}]}]}]}]}], "*)"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Convenience", " ", "function", " ", "collecting", " ", "the", " ", "full",
     " ", "thermal", " ", "solution", " ", "for", " ", "a", " ", "given", " ", 
    RowBox[{"TST", ".", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"Returns", ":", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "skin"}], " ", "flux"}], "\[IndentingNewLine]", "-", 
       RowBox[{"skin", " ", "temperature"}], "\[IndentingNewLine]", "-", 
       "inner", "\[IndentingNewLine]", "-", 
       RowBox[{"wall", " ", "temperature"}], "\[IndentingNewLine]", "-", 
       RowBox[{"s", " ", "and", " ", "u", " ", "grids"}], 
       "\[IndentingNewLine]", "-", 
       RowBox[{"convergence", " ", "information"}]}]}]}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"thermalFieldAtTime", "[", 
     RowBox[{"TST_", ",", 
      RowBox[{"curveStep_", ":", "4"}], ",", 
      RowBox[{"pointStep_", ":", "2"}], ",", 
      RowBox[{"nSGrid_", ":", "120"}], ",", 
      RowBox[{"nUGrid_", ":", "90"}], ",", 
      RowBox[{"TinitC_", ":", "30"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"skinSol", ",", "Tinner"}], "}"}], ",", "\[IndentingNewLine]", 
      
      RowBox[{"(*", 
       RowBox[{
       "Solve", " ", "the", " ", "skin", " ", "thermal", " ", "field"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"skinSol", "=", 
        RowBox[{"steadySkinTemperature", "[", 
         RowBox[{
         "TST", ",", "curveStep", ",", "pointStep", ",", "nSGrid", ",", 
          "nUGrid", ",", "TinitC"}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Estimate", " ", "inner"}], "-", 
         RowBox[{"wall", " ", "temperature"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"Tinner", "=", 
        RowBox[{"innerWallTemperatureField", "[", "skinSol", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<Flux\>\"", "\[Rule]", 
          RowBox[{"skinSol", "[", "\"\<Flux\>\"", "]"}]}], ",", 
         RowBox[{"\"\<SkinTempK\>\"", "\[Rule]", 
          RowBox[{"skinSol", "[", "\"\<SkinTempK\>\"", "]"}]}], ",", 
         RowBox[{"\"\<SkinTempC\>\"", "\[Rule]", 
          RowBox[{"skinSol", "[", "\"\<SkinTempC\>\"", "]"}]}], ",", 
         RowBox[{"\"\<InnerWallTempK\>\"", "\[Rule]", "Tinner"}], ",", 
         RowBox[{"\"\<InnerWallTempC\>\"", "\[Rule]", 
