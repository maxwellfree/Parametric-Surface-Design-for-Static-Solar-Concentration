             RowBox[{"\"\<AbsoluteRange\>\"", "->", "Indeterminate"}], ",", 
             RowBox[{"\"\<RelativeRange\>\"", "->", "Indeterminate"}], ",", 
             RowBox[{"\"\<StdDev\>\"", "->", "Indeterminate"}], ",", 
             RowBox[{"\"\<TemporalCV\>\"", "->", "Indeterminate"}]}], "|>"}], 
           "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"meanVal", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Mean", "[", "vals", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"minVal", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Min", "[", "vals", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"maxVal", "=", 
         RowBox[{"N", "[", 
          RowBox[{"Max", "[", "vals", "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeAbs", "=", 
         RowBox[{"N", "[", 
          RowBox[{"maxVal", "-", "minVal"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rangeRel", "=", 
         RowBox[{"If", "[", 
          RowBox[{
