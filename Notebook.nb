Cell[CellGroupData[{

Cell["Solar time and solar angles", "Section",
 CellChangeTimes->{{3.983027655431221*^9, 
  3.983027659945898*^9}},ExpressionUUID->"d369b091-c060-46ec-9073-\
a62d40c86448"],

Cell[CellGroupData[{

Cell["Hour angle and solar time", "Subsubsection",
 CellChangeTimes->{{3.983887112658231*^9, 
  3.9838871363229647`*^9}},ExpressionUUID->"40b7bbaa-60b9-4e40-9afd-\
22a34d5bb462"],

Cell["\<\
Hour angle H (in radians) computed from the true solar time (TST,in hours). \
The hour angle represents the angular displacement of the Sun with respect to \
the local meridian. It is zero at solar noon,negative in the morning,and \
positive in the afternoon. The factor 15\[Degree] per hour corresponds to the \
Earth's rotation rate.Subtracting 12 centers the system at solar noon.\
\>", "Text",
 CellChangeTimes->{{3.983887108179983*^9, 3.983887144168228*^9}, {
  3.983887205099444*^9, 
  3.983887208972294*^9}},ExpressionUUID->"8f385325-1d14-49f2-9c8f-\
463f4fd138e4"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"timeH", "[", "TST_", "]"}], ":=", 
   RowBox[{"15", " ", "Degree", " ", 
    RowBox[{"(", 
     RowBox[{"TST", "-", "12"}], ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.9838871029324493`*^9, 3.983887151243309*^9},
 CellLabel->"In[5]:=",ExpressionUUID->"1e2991e0-fd0e-4fa0-a914-cb3f0fc6d810"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Solar elevation and zenith angles", "Subsubsection",
 CellChangeTimes->{{3.983887181112962*^9, 
  3.98388718978776*^9}},ExpressionUUID->"d6940f1e-1199-4619-b38e-\
d8d044d28445"],

Cell["\<\
Solar zenith angle Z (in radians). This is the angle between the local \
vertical direction and the solar direction. Note:This angle is NOT the solar \
azimuth.\
\>", "Text",
 CellChangeTimes->{{3.983887167947646*^9, 
  3.9838871983957233`*^9}},ExpressionUUID->"9568dbd2-880a-43da-824f-\
f2a199192950"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zenith", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{"ArcCos", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "latitude", "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"delta", "[", "dn", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", "latitude", "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"timeH", "[", "TST", "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

 CellLabel->"In[6]:=",ExpressionUUID->"d80ba9c3-5e88-4a27-b01a-1354d519c055"],

Cell["\<\
Solar elevation angle h (in radians). This is the angle between the solar \
direction and the horizontal plane.\
\>", "Text",
 CellChangeTimes->{{3.983887246600355*^9, 
  3.9838872561310987`*^9}},ExpressionUUID->"a7529afa-d825-48d7-a4f0-\
9b4fa9c9b7a2"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{"ArcSin", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Sin", "[", "latitude", "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"delta", "[", "dn", "]"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"Cos", "[", "latitude", "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"timeH", "[", "TST", "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.983887238612589*^9, 3.983887241699181*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"b53fa721-7c90-4fd6-8e8f-6bed3abe79e3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Geometric solar azimuth (model convention)", "Subsubsection",
 CellChangeTimes->{{3.983887273370205*^9, 
  3.9838872795069838`*^9}},ExpressionUUID->"4a69adb9-dc2f-48da-bc64-\
672dac16304b"],

Cell["\<\
Solar azimuth in the geometric convention adopted for the mirror model.This \
is a signed angle in the horizontal xy-plane:-measured from the positive \
x-axis-counterclockwise-negative in the morning,positive in the afternoon \
This definition differs from standard solar azimuth formulations,but \
preserves continuity and is consistent with the geometric construction of the \
mirror surface.\
\>", "Text",
 CellChangeTimes->{{3.98388730763293*^9, 3.9838873147389593`*^9}},
 TextJustification->1.,ExpressionUUID->"889b63e6-c740-4a66-9c0f-b47153813178"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"azimuth", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sx", ",", "sy"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Horizontal", " ", "projection", " ", "of", " ", "the", " ", "solar", 
       " ", "direction"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sx", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "latitude", "]"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"timeH", "[", "TST", "]"}], "]"}]}], "-", 
        RowBox[{
         RowBox[{"Cos", "[", "latitude", "]"}], " ", 
         RowBox[{"Sin", "[", 
          RowBox[{"delta", "[", "dn", "]"}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sy", "=", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"delta", "[", "dn", "]"}], "]"}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"timeH", "[", "TST", "]"}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Quadrant", "-", 
        RowBox[{"aware", " ", "angle"}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"ArcTan", "[", 
       RowBox[{"sx", ",", "sy"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.98388730232445*^9, 3.983887328979645*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"b148b581-bd5a-40fb-8474-5a9b632956ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Consistency check", "Subsubsection",
 CellChangeTimes->{{3.9838874430025454`*^9, 
  3.9838874463471317`*^9}},ExpressionUUID->"d7c4915d-a4d8-41fb-812f-\
a207fdef0ef3"],

Cell["Example day for validation", "Text",
 CellChangeTimes->{{3.983887460025939*^9, 
  3.983887464187313*^9}},ExpressionUUID->"4a0bcf9a-e29e-4b73-a840-\
193005efcf1d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dn", "=", "160"}], ";"}]], "Input",
 CellChangeTimes->{{3.9838874367805367`*^9, 3.983887465900198*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"ca85166e-d415-4c74-b4d0-0bd4c0620bd0"],

Cell["The zenith angle must satisfy : zenith = Pi/2 - elevation", "Text",
 CellChangeTimes->{{3.983887477379704*^9, 
  3.9838874838438587`*^9}},ExpressionUUID->"539ca3f7-19e8-4c1e-9d94-\
468492767c15"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"zenith", "[", 
      RowBox[{"dn", ",", "hora"}], "]"}], ",", 
     RowBox[{
      RowBox[{"Pi", "/", "2"}], "-", 
      RowBox[{"h", "[", 
       RowBox[{"dn", ",", "hora"}], "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"hora", ",", "9", ",", "15"}], "}"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Solar time [h]\>\"", ",", "\"\<Angle [rad]\>\""}], "}"}]}], 
   ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"PlotTheme", "->", "\"\<Marketing\>\""}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<zenith\>\"", ",", "\"\<Pi/2 - elevation\>\""}], "}"}]}], 
   ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Bold", ",", "Large"}], "]"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "1000"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.983027695543538*^9, 3.98302771342034*^9}, 
