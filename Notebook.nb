Cell[CellGroupData[{

Cell["3 D visualization of the spatial range for day 200", "Subsubsection",
 CellChangeTimes->{
  3.9839611235504637`*^9},ExpressionUUID->"b871378b-aeb1-451a-b67f-\
a176aad559d2"],

Cell["\<\
This block generates a three-dimensional representation that combines:
\t-The surfaces corresponding to day 200 (SurfacesDay200)
\t-The reactor geometry for the same day (ReactorDay200) 

The objective is to visualize both structures within the same coordinate \
system (x,y,z) in order to analyze their spatial relationship.\
\>", "Text",
 CellChangeTimes->{{3.9839611376616373`*^9, 
  3.983961156620144*^9}},ExpressionUUID->"49f06b50-5314-4423-80d8-\
2ebe0a5fdddb"],

