]}]}]}]}]}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"concentrationRatioAtTST", "[", 
      RowBox[{"TST_", ",", 
       RowBox[{"rayLen_", ":", "3.0"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "data", ",", "hitData", ",", "geometricWeights", ",", 
         "reflectedPowerPerUnitDNI", ",", "C"}], "}"}], ",", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"data", "=", 
         RowBox[{"rayTracingDataAtTST", "[", 
          RowBox[{"TST", ",", "rayLen"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"hitData", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{"#", "[", "\"\<HitQ\>\"", "]"}], "&"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Weight", " ", "proportional", " ", "to", " ", "reflected", " ", 
           "power"}], ",", 
          RowBox[{"but", " ", "without", " ", "DNI"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"geometricWeights", "=", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"rhoMirror", "*", 
             RowBox[{"#", "[", "\"\<Weight\>\"", "]"}]}], ")"}], "&"}], "/@", 
          "hitData"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"This", " ", "is", " ", 
          RowBox[{"P_intercepted", "/", "DNI"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"reflectedPowerPerUnitDNI", "=", 
         RowBox[{"Total", "[", "geometricWeights", "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Concentration", " ", 
          RowBox[{"ratio", ":", 
           RowBox[{"DNI", " ", "cancels", " ", "out"}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"C", "=", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"reactorArea", ">", "0"}], ",", "\[IndentingNewLine]", 
           RowBox[{"N", "[", 
            RowBox[{"reflectedPowerPerUnitDNI", "/", "reactorArea"}], "]"}], 
           ",", "\[IndentingNewLine]", "Indeterminate"}], 
          "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"<|", 
         RowBox[{
          RowBox[{"\"\<TST\>\"", "->", "TST"}], ",", 
          RowBox[{
          "\"\<InterceptedPowerOverDNI\>\"", "->", 
           "reflectedPowerPerUnitDNI"}], ",", 
          RowBox[{"\"\<ReactorArea\>\"", "->", "reactorArea"}], ",", 
          RowBox[{"\"\<ConcentrationRatio\>\"", "->", "C"}]}], "|>"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", "Example", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"concentrationRatioAtTST", "[", 
    RowBox[{"12.0", ",", "3.0"}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Time", " ", "evolution"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"tstSamples", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"9.0", ",", "15.0", ",", "0.5"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"concentrationTable", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"concentrationRatioAtTST", "[", 
        RowBox[{"#", ",", "3.0"}], "]"}], "&"}], "/@", "tstSamples"}]}], 
    ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"concentrationDataset", "=", 
     RowBox[{"Dataset", "[", "concentrationTable", "]"}]}], ";"}], "\n", 
   "concentrationDataset", "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", "Summary", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"concentrationSummary", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<MeanC\>\"", "->", 
        RowBox[{"Mean", "[", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"concentrationTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<ConcentrationRatio\>\""}], "]"}], "]"}],
            ",", "Indeterminate"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<MinC\>\"", "->", 
        RowBox[{"Min", "[", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"concentrationTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<ConcentrationRatio\>\""}], "]"}], "]"}],
            ",", "Indeterminate"}], "]"}], "]"}]}], ",", 
       RowBox[{"\"\<MaxC\>\"", "->", 
        RowBox[{"Max", "[", 
         RowBox[{"DeleteCases", "[", 
          RowBox[{
           RowBox[{"concentrationTable", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "\"\<ConcentrationRatio\>\""}], "]"}], "]"}],
            ",", "Indeterminate"}], "]"}], "]"}]}]}], "|>"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"concentrationSummary", "//", "Dataset"}]}]}]], "Input",
