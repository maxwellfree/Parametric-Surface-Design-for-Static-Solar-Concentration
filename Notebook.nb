      RowBox[{"\"\<Surface RMS error [m]\>\"", "\[Rule]", "surfaceRMSError"}],
       ",", 
      RowBox[{"\"\<Focus max error [m]\>\"", "\[Rule]", "focusMaxError"}], 
      ",", 
      RowBox[{"\"\<Focus mean error [m]\>\"", "\[Rule]", "focusMeanError"}], 
      ",", 
      RowBox[{"\"\<Focus RMS error [m]\>\"", "\[Rule]", "focusRMSError"}]}], 
     "}"}]}]}]}]], "Input",
