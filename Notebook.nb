Cell[CellGroupData[{

Cell["\<\
Generation of the mirror surface and focal trajectory for selected days\
\>", "Section",
 CellChangeTimes->{{3.9830287238948383`*^9, 3.983028727121586*^9}, 
   3.9830297239073143`*^9},ExpressionUUID->"838d60bb-13f4-49c3-a341-\
18c384b60ec6"],

Cell["\<\
This block defines a reusable function that generates both the mirror surface \
and the associated focal trajectory for any selected day of the year.The \
construction is performed by sweeping the true solar time over the operating \
interval.For each solar time:-a local parabolic section is generated in the \
xz-plane,-the corresponding focal point is computed,-both are rotated \
according to the geometric azimuth,-and translated along the horizontal solar \
sweep.The output is stored as an association with two \
components:\"Surface\",containing the collection of transformed parabolic \
sections,and \"Focus\",containing the corresponding transformed focal \
points.This modular construction makes it possible to compare mirror \
geometries generated for different days under identical sampling conditions.\
\>", "Text",
 CellChangeTimes->{{3.983029736353767*^9, 3.9830297468212214`*^9}},
 TextJustification->1.,ExpressionUUID->"0683126f-a1de-4adc-b0eb-8e49fd8c237e"],

Cell[CellGroupData[{

Cell["\<\
Reusable generator for the mirror surface and focal trajectory\
\>", "Subsubsection",
 CellChangeTimes->{{3.983959333812626*^9, 
  3.983959340338457*^9}},ExpressionUUID->"e8efb39a-b0f6-4cdb-8374-\
ffb28599d1c8"],

Cell["\<\
GenerateSurfaceAndFocus[dn] constructs the mirror surface and the \
corresponding focal trajectory for a given day of the year.
Input:
\t- dn:day number of the year Output:
\t- an association with two entries:
                                                \"Surface\"->collection of \
transformed parabolic sections 
                                                \"Focus\"->collection of \
transformed focal points\
\>", "Text",
 CellChangeTimes->{{3.983959403293868*^9, 3.983959420114208*^9}, {
  3.983959450450288*^9, 3.98395946731393*^9}, {3.983961736055155*^9, 
  3.983961736856636*^9}},ExpressionUUID->"677e9104-450f-463f-84ee-\
bd501284ca71"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"GenerateSurfaceAndFocus", "[", "dn_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"j", "=", "0"}], ",", "yNormLocal", ",", "data", ",", 
       "focus"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Normalization", " ", "factor", " ", "for", " ", "the", " ", "lateral", 
       " ", "displacement", " ", "over", " ", "the", " ", "full", " ", 
       "operating", " ", "interval", " ", "of", " ", "the", " ", "selected", 
       " ", 
       RowBox[{"day", ".", "This"}], " ", "ensures", " ", "that", " ", "the", 
       " ", "horizontal", " ", "sweep", " ", "is", " ", "consistently", " ", 
       RowBox[{"scaled", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"yNormLocal", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Abs", "@", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"y", "[", 
            RowBox[{"dn", ",", "TST"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"TST", ",", 
             RowBox[{"12", "-", "3"}], ",", 
             RowBox[{"12", "+", "3"}], ",", "0.01"}], "}"}]}], "]"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Sweep", " ", "the", " ", "true", " ", "solar", " ", "time", " ", 
        "over", " ", "the", " ", "selected", " ", "operating", " ", 
        RowBox[{"window", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"TST", "=", 
         RowBox[{"12", "-", "3"}]}], ",", 
        RowBox[{"TST", "<=", 
         RowBox[{"12", "+", "3"}]}], ",", 
        RowBox[{"TST", "+=", "0.05"}], ",", 
        RowBox[{
         RowBox[{"j", "=", 
          RowBox[{"j", "+", "1"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Initialize", " ", "storage", " ", "for", " ", "the", " ", 
           "current", " ", "parabolic", " ", "section", " ", "and", " ", 
           "focal", " ", 
           RowBox[{"point", "."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"data", "[", "j", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"focus", "[", "j", "]"}], "=", 
          RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Generate", " ", "the", " ", "local", " ", "parabolic", " ", 
            "profile", " ", "in", " ", "the", " ", "xz"}], "-", 
           RowBox[{
           "plane", " ", "by", " ", "sweeping", " ", "the", " ", "parabola", 
            " ", "parameter", " ", 
            RowBox[{"t", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"For", "[", 
          RowBox[{
           RowBox[{"i", "=", 
            RowBox[{"-", "600"}]}], ",", 
           RowBox[{"i", "<=", "600"}], ",", 
           RowBox[{"i", "++"}], ",", 
           RowBox[{
            RowBox[{"t", "=", 
             RowBox[{"i", "/", "200"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"data", "[", "j", "]"}], "=", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{"data", "[", "j", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"xref", "[", 
                  RowBox[{"dn", ",", "TST", ",", "t"}], "]"}], ",", "0", ",", 
                 
                 RowBox[{"zref", "[", 
                  RowBox[{"dn", ",", "TST", ",", "t"}], "]"}]}], "}"}]}], 
              "]"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Local", " ", "focal", " ", "point", " ", "before", " ", "the", " ",
            "rigid", " ", 
           RowBox[{"transformation", "."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"focus", "[", "j", "]"}], "=", 
          RowBox[{"{", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"fx", "[", 
              RowBox[{"dn", ",", "TST"}], "]"}], ",", "0", ",", 
             RowBox[{"fz", "[", 
              RowBox[{"dn", ",", "TST"}], "]"}]}], "}"}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "Apply", " ", "the", " ", "rigid", " ", "transformation", " ", 
            "to", " ", "the", " ", "focal", " ", 
            RowBox[{"point", ":", 
             RowBox[{
              RowBox[{"-", "rotation"}], " ", "by", " ", "the", " ", 
              "opposite", " ", "of", " ", "the", " ", "geometric", " ", 
              "azimuth"}]}]}], ",", 
           RowBox[{
            RowBox[{"-", "translation"}], " ", "along", " ", "the", " ", 
            "horizontal", " ", "solar", " ", 
            RowBox[{"trajectory", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"focus", "[", "j", "]"}], "=", 
          RowBox[{"TransformCurve", "[", 
           RowBox[{
            RowBox[{"focus", "[", "j", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"azimuth", "[", 
              RowBox[{"dn", ",", "TST"}], "]"}]}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"dn", ",", "TST"}], "]"}], ",", 
            RowBox[{
             RowBox[{"FacadeLength", "/", "2"}], "*", 
             RowBox[{
              RowBox[{"y", "[", 
               RowBox[{"dn", ",", "TST"}], "]"}], "/", "yNormLocal"}]}]}], 
           "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
          "Apply", " ", "the", " ", "same", " ", "rigid", " ", 
           "transformation", " ", "to", " ", "the", " ", "full", " ", 
           "parabolic", " ", 
           RowBox[{"section", "."}]}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"data", "[", "j", "]"}], "=", 
          RowBox[{"TransformCurve", "[", 
           RowBox[{
            RowBox[{"data", "[", "j", "]"}], ",", 
            RowBox[{"-", 
             RowBox[{"azimuth", "[", 
              RowBox[{"dn", ",", "TST"}], "]"}]}], ",", 
            RowBox[{"x", "[", 
             RowBox[{"dn", ",", "TST"}], "]"}], ",", 
            RowBox[{
             RowBox[{"FacadeLength", "/", "2"}], "*", 
             RowBox[{
              RowBox[{"y", "[", 
               RowBox[{"dn", ",", "TST"}], "]"}], "/", "yNormLocal"}]}]}], 
           "]"}]}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Return", " ", "both", " ", "the", " ", "mirror", " ", "surface", " ", 
        "and", " ", "the", " ", "focal", " ", "trajectory", " ", "as", " ", 
        "an", " ", 
        RowBox[{"association", "."}]}], "*)"}], 
      RowBox[{"<|", 
       RowBox[{
        RowBox[{"\"\<Surface\>\"", "->", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"data", "[", "k", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "j"}], "}"}]}], "]"}]}], ",", 
        RowBox[{"\"\<Focus\>\"", "->", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"focus", "[", "k", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"k", ",", "1", ",", "j"}], "}"}]}], "]"}]}]}], "|>"}]}]}],
     "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9830297623170757`*^9, 3.9830297803102007`*^9}, 
   3.983109029349242*^9, {3.983360028392887*^9, 3.9833600382751217`*^9}, {
   3.983881712934092*^9, 3.98388174005916*^9}, 3.983881770660974*^9, 
   3.983959301387682*^9, 3.983959353069916*^9},
 CellLabel->"In[36]:=",ExpressionUUID->"bb4482b2-cad5-4716-8fe8-8d93e5693e99"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Generation of mirror surfaces for two representative summer days\
\>", "Subsubsection",
 CellChangeTimes->{{3.983959491196566*^9, 
  3.983959497602025*^9}},ExpressionUUID->"6be10b36-f443-46c3-a39c-\
b3caf23785fa"],

Cell["\<\
Two representative summer days are considered in order to compare the \
resulting mirror geometries and focal trajectories.Day 145 is used as a \
reference summer day.Day 200 is introduced as a nearby operating day to \
evaluate whether the mirror geometry remains practically unchanged within the \
selected summer interval.\
\>", "Text",
 CellChangeTimes->{{3.983960482658485*^9, 
  3.983960494048622*^9}},ExpressionUUID->"fdfc8b37-9cfc-48b9-85b4-\
867aa9f50a28"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"25", "/", "May"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"day145", "=", 
     RowBox[{"GenerateSurfaceAndFocus", "[", "145", "]"}]}], ";"}], " ", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"19", "/", "July"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"day200", "=", 
     RowBox[{"GenerateSurfaceAndFocus", "[", "200", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.983029798065893*^9, 3.983029798066332*^9}, 
   3.9831090185294733`*^9, {3.9834203501692057`*^9, 3.983420404022547*^9}, {
