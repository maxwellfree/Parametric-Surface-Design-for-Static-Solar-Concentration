Cell[CellGroupData[{

Cell["Parametric construction of the mirror surface", "Section",
 CellChangeTimes->{{3.9830285214859657`*^9, 
  3.983028524301326*^9}},ExpressionUUID->"5d634078-c2db-4740-bc0a-\
273879f9f11f"],

Cell["\<\
This section introduces the full parametric construction of the mirror \
surface . The mirror is generated as a collection of local parabolic sections \
defined in the vertical plane (xz - plane), which are subsequently positioned \
in space through rigid transformations . 

Each section is : 
\t-oriented according to the solar zenith angle (vertical tilt),
\t-rotated according to the geometric solar azimuth (horizontal sweep),
\t-translated along the horizontal solar trajectory . 
  
The combination of these operations produces the complete three - dimensional \
geometry of the mirror as an envelope of time - dependent parabolic profiles .\
\>", "Text",
 CellChangeTimes->{{3.983028541656225*^9, 3.983028544165925*^9}, {
  3.983888180883363*^9, 3.98388821247444*^9}, {3.9839587353271303`*^9, 
  3.983958745583008*^9}, {3.983961715470879*^9, 
  3.98396171866261*^9}},ExpressionUUID->"f781ee00-2ff8-4fbe-9312-\
716cfd3e3178"],

Cell[CellGroupData[{

Cell["Rigid transformation in 3 D space", "Subsubsection",
 CellChangeTimes->{{3.983958793227915*^9, 
  3.9839587963403597`*^9}},ExpressionUUID->"7da2b623-d34f-4c99-8a79-\
b770dc5cefc6"],

Cell["\<\
Rigid transformation of a 3D point set:-first,a rotation around the \
z-axis,-then,a translation in the xy-plane.This transformation is essential \
to correctly place each local parabolic section in the global coordinate \
system,assigning both its azimuthal orientation and its horizontal position \
along the solar trajectory.\
\>", "Text",
 CellChangeTimes->{{3.983958777618812*^9, 
  3.983958803167808*^9}},ExpressionUUID->"40dc8953-14f2-43c6-aeda-\
ba876b5367c1"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"TransformCurve", "[", 
    RowBox[{"points_List", ",", "angle_", ",", "dx_", ",", "dy_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rotationMatrix", ",", "rotatedPoints"}], "}"}], ",", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{
       "Rotation", " ", "matrix", " ", "around", " ", "the", " ", "z"}], "-", 
       "axis"}], "*)"}], 
     RowBox[{
      RowBox[{"rotationMatrix", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Cos", "[", "angle", "]"}], ",", 
           RowBox[{"-", 
            RowBox[{"Sin", "[", "angle", "]"}]}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Sin", "[", "angle", "]"}], ",", 
           RowBox[{"Cos", "[", "angle", "]"}], ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0", ",", "1"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"Apply", " ", "rotation"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"rotatedPoints", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"rotationMatrix", ".", "#"}], ")"}], "&"}], "/@", 
        "points"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "Apply", " ", "translation", " ", "in", " ", "the", " ", "xy"}], "-", 
        "plane"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"#", "+", 
          RowBox[{"{", 
           RowBox[{"dx", ",", "dy", ",", "0"}], "}"}]}], ")"}], "&"}], "/@", 
       "rotatedPoints"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{3.9839587703769903`*^9},
 CellLabel->"In[27]:=",ExpressionUUID->"a0ed8a36-4ae7-45d9-990b-822cc21ebbc6"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Local parabolic profile (vertical plane)", "Subsubsection",
 CellChangeTimes->{{3.983958934150578*^9, 
  3.983958939585703*^9}},ExpressionUUID->"8662e87d-c9cc-4519-ae87-\
cf10e3a54e76"],

Cell["Focal length of the parabolic cross-section (in meters)", "Text",
 CellChangeTimes->{
  3.983958892033579*^9, {3.9839589322492027`*^9, 
   3.983958945240196*^9}},ExpressionUUID->"0b6c1be9-3c0d-4e90-81cd-\
c1f753066440"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", "1"}], ";"}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"2531c502-8e1c-4b34-9cc4-a33f5afd343c"],

Cell["\<\
Local x - coordinate of the parabolic profile . The parabola is defined in \
the vertical plane and rotated according to the solar zenith angle, which \
determines the inclination of the incident solar rays .\
\>", "Text",
 CellChangeTimes->{{3.983958964744794*^9, 
  3.983958987195128*^9}},ExpressionUUID->"4b8d0dc0-46e0-4e6f-86db-\
3ced6deb9523"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"xref", "[", 
    RowBox[{"dn_", ",", "TST_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"zenith", "[", 
       RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"zenith", "[", 
       RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[29]:=",ExpressionUUID->"8b8f7284-fc1a-4223-b674-9a4964a8ad78"],

Cell["Local z - coordinate of the parabolic profile .", "Text",
 CellChangeTimes->{{3.983959009344722*^9, 
  3.983959016409124*^9}},ExpressionUUID->"4676694e-f480-4ed7-abd2-\
5f1b5aa79b54"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zref", "[", 
    RowBox[{"dn_", ",", "TST_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"zenith", "[", 
       RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"zenith", "[", 
       RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[30]:=",ExpressionUUID->"8814b7ba-b894-40d1-819d-1c5736c1d59d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Focal trajectory", "Subsubsection",
 CellChangeTimes->{
  3.983959046403675*^9},ExpressionUUID->"995ee5b7-b8bb-4061-8ebf-\
77cd14a87b07"],

Cell["\<\
Horizontal coordinate of the focal point . The focal point shifts \
horizontally according to the solar elevation .\
\>", "Text",
 CellChangeTimes->{
  3.983959059418167*^9},ExpressionUUID->"ed9b45d2-c65f-467b-840d-\
e8b5e826de7f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fx", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "f"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[31]:=",ExpressionUUID->"c0e2b017-5d1c-4d18-ac4c-15eef5db6872"],

Cell["\<\
Vertical coordinate of the focal point.The focal point rises and descends \
following the solar elevation.\
\>", "Text",
 CellChangeTimes->{{3.9839590907086287`*^9, 
  3.9839590967046137`*^9}},ExpressionUUID->"a8e7c03b-29b1-4312-8e14-\
57db3512a4ee"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"fz", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{"f", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.983959041977232*^9, 3.9839591020174294`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"77f0cafd-2fd4-40ae-bb4a-266f8ed20636"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Horizontal solar projection (geometric azimuth)", "Subsubsection",
 CellChangeTimes->{{3.9839591160589933`*^9, 
  3.98395912040932*^9}},ExpressionUUID->"627d8722-118d-4888-ae52-\
cdce87fd8432"],

Cell["\<\
Horizontal x - component of the solar direction . The projection is defined \
using the geometric azimuth introduced previously, ensuring consistency with \
the model reference frame .\
\>", "Text",
 CellChangeTimes->{
  3.98395913859344*^9},ExpressionUUID->"3a66a5ef-3428-47a9-87e3-dbad1adeabc8"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"azimuth", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"942ff8f5-a7b5-47ed-9ac2-19433f352262"],

Cell["Horizontal y - component of the solar direction .", "Text",
 CellChangeTimes->{{3.9839591621936493`*^9, 
  3.983959172019281*^9}},ExpressionUUID->"3651d6f4-0e6a-46d4-ac02-\
e2be8b08ed2c"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"azimuth", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"71ff4ca3-071e-4290-b231-14a1499e8273"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Geometric scaling parameters", "Subsubsection",
 CellChangeTimes->{{3.983959183889155*^9, 
  3.983959215890422*^9}},ExpressionUUID->"2a4374ff-4660-4298-943e-\
a3bc62256726"],

Cell["\<\
Facade length (in meters) . This parameter defines the physical extent of the \
mirror system in the horizontal direction and is used later to scale the \
solar sweep .\
\>", "Text",
 CellChangeTimes->{
  3.983959222457406*^9},ExpressionUUID->"d7d7e746-4699-4e4f-9948-\
6c8078d9cb69"],

Cell[BoxData[
 RowBox[{
  RowBox[{"FacadeLength", "=", "30"}], ";"}]], "Input",
 CellChangeTimes->{{3.983028578118535*^9, 3.983028578118966*^9}, {
   3.983417462986203*^9, 3.9834174831829367`*^9}, {3.983881644006404*^9, 
   3.983881702716687*^9}, 3.983958761337203*^9, {3.983958874033379*^9, 
