Notebook[{

Cell[CellGroupData[{
Cell["\<\
Parametric Surface Design for Static Solar Concentration : Enhancing Plastic \
Waste Pyrolysis in Sustainable Housing
Mathematics and Computers in Simulation\
\>", "Title",
 CellChangeTimes->{{3.983961220005086*^9, 
  3.983961241899946*^9}},ExpressionUUID->"5b4a3e5c-937a-498c-8c0f-\
733a39e6e9f9"],

Cell[TextData[{
 "This work develops a mathematical framework for the design of static \
parabolic solar concentrators with purely parametric geometries, aimed at \
replacing mechanically tracked systems . The central problem is to translate \
the apparent solar motion into a continuous parabolic surface whose focal \
line evolves consistently with the sun' s trajectory . We formulate the \
astronomical parameters (solar declination, hour angle, azimuth-- elevation) \
and show how each parabola, defined in its local plane, is rotated and \
assembled into a complete surface through parametric transformations . To \
ensure smoothness and predictable reflection properties, the resulting point \
cloud is interpolated using spline - based methods that guarantee ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["C", "2"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1a6def03-dd03-4b5d-8f9f-b9a32a42dca3"],
 " continuity, enabling reliable computation of tangents and normals . \
Practical implementation is achieved through an embedded device that verifies \
point placement during construction, bridging theoretical design with \
reproducible fabrication . While the broader motivation of this study is to \
address plastic waste through solar pyrolysis, the focus here is on the \
mathematical formulation that underpins the geometry and interpolation \
techniques necessary for building resilient, low - cost, and efficient static \
concentrators ."
}], "Text",
 CellChangeTimes->{{3.983961326195496*^9, 3.983961368217593*^9}},
 TextJustification->1.,ExpressionUUID->"10599335-a9e8-40e6-993a-a526fad41cbe"],

Cell[CellGroupData[{

Cell["Solar geometry : latitude, day angle and solar declination", "Section",
 CellChangeTimes->{{3.983027396523788*^9, 
  3.983027404613921*^9}},ExpressionUUID->"040a33e1-ead7-4a52-b024-\
c4daa682bcbf"],

Cell[CellGroupData[{

Cell["Definition of site latitude", "Subsubsection",
 CellChangeTimes->{{3.983884169483708*^9, 
  3.983884216515616*^9}},ExpressionUUID->"a1211a20-0e17-4150-bbe4-\
bdce6def1743"],

Cell["\<\
Site latitude in radians.The reference location considered in this model is \
set to 37 degrees north.This parameter defines the observer position on Earth \
and directly affects the solar trajectory and all derived solar angles.\
\>", "Text",
 CellChangeTimes->{{3.983884203469401*^9, 
  3.983884221755167*^9}},ExpressionUUID->"3ad9cac6-88cc-4598-a7a5-\
007542750d85"],

Cell[BoxData[
 RowBox[{
  RowBox[{"latitude", "=", 
   RowBox[{"37", " ", "Degree"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.983884164058873*^9, 3.983884166378076*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"a30a01a0-6acd-42ab-99de-89ca844b6be5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Day angle and solar declination (Spencer model)", "Subsubsection",
 CellChangeTimes->{{3.9838842556911783`*^9, 
  3.983884313925418*^9}},ExpressionUUID->"c19cc24f-0139-4c16-b881-\
9a16a0f7308e"],

Cell["\<\
Daily angle beta(dn),also known as the day angle.This variable maps the day \
of the year (dn) into a periodic angular scale,representing the Earth's orbit \
around the Sun.\
\>", "Text",
 CellChangeTimes->{
  3.9838842883267393`*^9, {3.9838843197258797`*^9, 
   3.983884321813046*^9}},ExpressionUUID->"0a231bf1-6783-4853-bc0f-\
366f48089acd"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"beta", "[", "dn_", "]"}], ":=", 
   RowBox[{"2", " ", "Pi", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"dn", "-", "1"}], ")"}], "/", "365"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.983884241198341*^9, 3.983884330055298*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"b8d7ce7b-5408-4270-b1d2-63a78846f155"]
}, Open  ]],

Cell[CellGroupData[{

Cell["\<\
Solar declination delta (dn) computed using Spencer' s Fourier - series \
approximation .\
\>", "Subsubsection",
 CellChangeTimes->{{3.983958446268036*^9, 
  3.983958451008708*^9}},ExpressionUUID->"ec81bc17-628c-4af8-a06c-\
5a40ca834aea"],

Cell["\<\
This analytical expression provides a high-accuracy representation of the \
seasonal variation of the solar declination angle.The declination angle \
defines the tilt between the Earth's equatorial plane and the Sun-Earth \
direction,and it is a key input for computing solar elevation and azimuth \
angles.\
\>", "Text",
 CellChangeTimes->{{3.983886972619381*^9, 3.9838869929731503`*^9}, {
  3.983958438901862*^9, 
  3.983958444174233*^9}},ExpressionUUID->"e669eb09-3f7f-4d0f-ac14-\
77a9f8219369"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"delta", "[", "dn_", "]"}], ":=", 
   RowBox[{"0.006918", "-", 
    RowBox[{"0.399912", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"beta", "[", "dn", "]"}], "]"}]}], "+", 
    RowBox[{"0.070257", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"beta", "[", "dn", "]"}], "]"}]}], "-", 
    RowBox[{"0.006758", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", 
       RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}], "+", 
    RowBox[{"0.000907", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", " ", 
       RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}], "-", 
    RowBox[{"0.002697", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"3", " ", 
       RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}], "+", 
    RowBox[{"0.00148", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"3", " ", 
       RowBox[{"beta", "[", "dn", "]"}]}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[3]:=",ExpressionUUID->"3e896ab6-f45a-4973-be55-e405b1a0f86b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Visualization of solar declination over the year .", "Subsubsection",
 CellChangeTimes->{{3.983958460993429*^9, 
  3.983958464455799*^9}},ExpressionUUID->"772ed0e3-8d7e-4956-bd97-\
732379d35037"],

Cell["\<\
This plot illustrates the seasonal variation of the declination angle,ranging \
approximately between-23.44\[Degree] and+23.44\[Degree].\
\>", "Text",
 CellChangeTimes->{{3.983887034333765*^9, 3.983887041747437*^9}, 
   3.983958459086109*^9},ExpressionUUID->"b19bf29f-4653-470d-b4aa-\
e2f064e033d2"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"delta", "[", "dd", "]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"dd", ",", "1", ",", "365"}], "}"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Day of year (dn)\>\"", ",", "\"\<\[Delta] [rad]\>\""}], 
     "}"}]}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"PlotTheme", "->", "\"\<Marketing\>\""}], ",", 
   RowBox[{"LabelStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Black", ",", "Bold", ",", "Large"}], "]"}]}], ",", 
   RowBox[{"ImageSize", "\[Rule]", "1000"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.9830274888300333`*^9, 3.983027504202394*^9}, 
   3.983439400801386*^9, 3.9834399286083403`*^9, {3.983439968346757*^9, 
   3.9834399687448463`*^9}, 3.983440380632159*^9, 3.983440576587061*^9, {
   3.983881222243534*^9, 3.983881230309791*^9}, 3.983881265163837*^9, 
