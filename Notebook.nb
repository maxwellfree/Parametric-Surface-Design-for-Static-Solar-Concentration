Cell[CellGroupData[{

Cell["\<\
Section - by - section distances : one mean value is obtained for each TST\
\>", "Subsubsection",
 CellChangeTimes->{
  3.983961856327112*^9},ExpressionUUID->"741953f7-e947-442f-90ae-\
5d6c9ad93744"],

Cell["\<\
sectionErrors will store, for each section k, a single discrepancy measure \
between the surfaces of day 145 and day 200. The idea is :
    \t1. Take section k from SurfacesDay145 .
    \t2. Take the corresponding section k from SurfacesDay200 .
    \t3. Compare both point lists point by point .
  \t4. Compute the Euclidean distance between each pair of homologous points \
.
   \t5. Average all these distances .
   \t6. Store that average as the mean error of section k .\
\>", "Text",
 CellChangeTimes->{{3.983961876304337*^9, 
  3.983961911423785*^9}},ExpressionUUID->"ca13dc6e-14ff-47a8-92e8-\
055b1ac41cad"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"sectionErrors", "=", 
    RowBox[{"Table", "[", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Mean", "[", "...", "]"}], " ", "computes", " ", "the", " ", 
       "average", " ", "of", " ", "all", " ", "pointwise", " ", "distances", 
       " ", "obtained", " ", "when", " ", "comparing", " ", "section", " ", 
       "k", " ", "of", " ", "both", " ", 
       RowBox[{"days", "."}]}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Mean", "[", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{
          "MapThread", " ", "applies", " ", "EuclideanDistance", " ", "by", 
           " ", "pairing", " ", "elements", " ", "from", " ", "the", " ", 
           "two", " ", 
           RowBox[{"lists", ":", "\[IndentingNewLine]", 
            RowBox[{"-", 
             RowBox[{"SurfacesDay145", "[", 
              RowBox[{"[", "k", "]"}], "]"}]}]}]}], "\[Rule]", 
          RowBox[{
           RowBox[{
            RowBox[{
            "list", " ", "of", " ", "points", " ", "from", " ", "section", 
             " ", "k", " ", "of", " ", "day", " ", "145"}], 
            "\[IndentingNewLine]", "-", 
            RowBox[{"SurfacesDay200", "[", 
             RowBox[{"[", "k", "]"}], "]"}]}], "\[Rule]", 
           RowBox[{
           "list", " ", "of", " ", "points", " ", "from", " ", "section", " ",
             "k", " ", "of", " ", "day", " ", "200", " ", 
            "\[IndentingNewLine]", "If", " ", "both", " ", "lists", " ", 
            "were"}]}]}], ",", 
         RowBox[{"for", " ", 
          RowBox[{"example", ":", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"p1", ",", "p2", ",", "p3"}], "}"}], " ", 
            "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"q1", ",", "q2", ",", "q3"}], "}"}], " ", 
            "\[IndentingNewLine]", "then", " ", "it", " ", "would", " ", 
            "compute"}], ":", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"EuclideanDistance", "[", 
             RowBox[{"p1", ",", "q1"}], "]"}], " ", "\[IndentingNewLine]", 
            RowBox[{"EuclideanDistance", "[", 
             RowBox[{"p2", ",", "q2"}], "]"}], " ", "\[IndentingNewLine]", 
            RowBox[{"EuclideanDistance", "[", 
             RowBox[{"p3", ",", "q3"}], "]"}], " ", "\[IndentingNewLine]", 
            "producing", " ", "a", " ", "list", " ", "of", " ", 
            RowBox[{"distances", "."}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"MapThread", "[", 
        RowBox[{"EuclideanDistance", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"SurfacesDay145", "[", 
            RowBox[{"[", "k", "]"}], "]"}], ",", 
           RowBox[{"SurfacesDay200", "[", 
            RowBox[{"[", "k", "]"}], "]"}]}], "}"}]}], "]"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "The", " ", "index", " ", "k", " ", "runs", " ", "through", " ", "all",
         " ", "available", " ", "sections", " ", "in", " ", 
        RowBox[{"SurfacesDay145", ".", "It"}], " ", "is", " ", "assumed", " ",
         "that", " ", "SurfacesDay200", " ", "has", " ", "the", " ", "same", 
        " ", "structure", " ", "and", " ", "the", " ", "same", " ", "number", 
        " ", "of", " ", "corresponding", " ", 
        RowBox[{"sections", "."}]}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"k", ",", "1", ",", 
        RowBox[{"Length", "[", "SurfacesDay145", "]"}]}], "}"}]}], "]"}]}], 
   ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"--", 
    RowBox[{"--", 
     RowBox[{"--", 
      RowBox[{"--", 
       RowBox[{"--", 
        RowBox[{"--", 
         RowBox[{"--", 
          RowBox[{"--", 
           RowBox[{"--", 
