           "Indeterminate"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "vals", "]"}], "==", "0"}], ",", 
          RowBox[{"Return", "[", 
           RowBox[{"<|", 
