Cell[CellGroupData[{

Cell["Local parabolic profile driven by solar elevation", "Section",
 CellChangeTimes->{{3.983028206466506*^9, 
  3.9830282118177834`*^9}},ExpressionUUID->"868a51be-74d6-41b5-ac46-\
d77774aeabc9"],

Cell["\<\
This section illustrates how the local parabolic cross - section of the \
mirror evolves throughout the day as a function of the solar elevation . The \
purpose of this block is mainly interpretative : through static examples and \
animations, it helps to understand how each parabola tilts, rises, and \
descends as the Sun moves from morning to afternoon . In this stage, only the \
vertical plane (xz - plane) is considered . 

The horizontal azimuthal sweep will be introduced later in the full three - \
dimensional construction of the mirror surface .

Mirror profile for a fixed day.This section illustrates how each local \
parabolic cross-section is generated in the vertical plane as a function of \
solar time.The local profile is controlled by the solar zenith angle,whereas \
the horizontal azimuthal sweep is introduced later in the full 3D \
construction of the mirror surface.\
\>", "Text",
 CellChangeTimes->{{3.983028222075953*^9, 3.983028262267428*^9}, {
  3.983961659559401*^9, 3.9839616613346767`*^9}},
 TextJustification->1.,ExpressionUUID->"a31c00b1-c071-4668-923a-606490dad16c"],

Cell["\<\
Reference day and geometric parameters. Selected day of the year.This example \
uses day 160,corresponding approximately to early June in a non-leap year.\
\>", "Text",
 CellChangeTimes->{{3.983887781893922*^9, 
  3.98388779032554*^9}},ExpressionUUID->"b41d5db5-ed30-4677-a9f5-\
4e383b7ae07d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dn", "=", "160"}], ";"}]], "Input",
 CellLabel->"In[18]:=",ExpressionUUID->"afa6f5ba-067a-4af7-b00b-2a6d574f0931"],

Cell["Focal length of the parabolic mirror (in meters).", "Text",
 CellChangeTimes->{{3.983887810675603*^9, 
  3.983887815326186*^9}},ExpressionUUID->"43c190fa-51ec-4180-a44d-\
5ce48afb61f8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"f", "=", "1"}], ";"}]], "Input",
 CellLabel->"In[19]:=",ExpressionUUID->"f6cf6bd3-dd72-4d73-943a-95ebc1244d05"],

Cell[CellGroupData[{

Cell["Local orientation of the parabolic profile . ", "Subsubsection",
 CellChangeTimes->{{3.983958623580844*^9, 
  3.9839586262175503`*^9}},ExpressionUUID->"ad470ed6-c27d-4225-8385-\
72acc7d46a3e"],

Cell["\<\
Local rotation angle of the parabolic section.The profile is oriented \
according to the solar zenith angle,which defines the inclination of the \
incoming solar rays in the vertical plane.\
\>", "Text",
 CellChangeTimes->{{3.983887835455194*^9, 3.983887850358176*^9}, 
   3.9839586215347233`*^9},ExpressionUUID->"bd4f6626-8687-48a8-952c-\
28a7bb92d330"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"thetaLocal", "[", "TST_", "]"}], ":=", 
   RowBox[{"zenith", "[", 
    RowBox[{"dn", ",", "TST"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[20]:=",ExpressionUUID->"737ae0c4-b540-4548-90df-46010621db4a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Parametric definition of the parabolic profile :", "Subsubsection",
 CellChangeTimes->{{3.983958635931098*^9, 
  3.9839586390346937`*^9}},ExpressionUUID->"c4e2cb75-2786-4e65-ac91-\
924ab4eeb09d"],

Cell["\<\
Local x-coordinate of the rotated parabola.The expression corresponds to a \
standard parabola rotated by the zenith angle.\
\>", "Text",
 CellChangeTimes->{{3.983887868998787*^9, 3.98388790351968*^9}, {
  3.983958634142352*^9, 
  3.983958634806242*^9}},ExpressionUUID->"fcb6aa42-81c2-4968-be3b-\
161b5bf490e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"xLocal", "[", 
    RowBox[{"t_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"4901ea7f-531f-48d3-80d7-1ad4d9113df6"],

Cell["Local z - coordinate of the rotated parabola .", "Text",
 CellChangeTimes->{{3.983887927895502*^9, 
  3.983887934317759*^9}},ExpressionUUID->"ba16008f-1ce4-48a1-bb1f-\
a75c2450126e"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"zLocal", "[", 
    RowBox[{"t_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"t", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"4", " ", "f"}], ")"}]}], ")"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"thetaLocal", "[", "TST", "]"}], "]"}]}]}]}], ";"}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"aa4a6324-1fc5-4089-9ac8-e8568b8542a5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Focal point associated with the solar elevation", "Subsubsection",
 CellChangeTimes->{{3.983958649385536*^9, 
  3.983958652737101*^9}},ExpressionUUID->"81374c9b-a1e7-4a2f-a1ae-\
ab0851ea2856"],

Cell["\<\
The focal point follows the solar elevation angle.Its position shifts \
vertically throughout the day as the Sun rises and sets.\
\>", "Text",
 CellChangeTimes->{{3.98388794748839*^9, 3.983887963352228*^9}, {
  3.983958647783103*^9, 
  3.983958648190714*^9}},ExpressionUUID->"00cc0fa8-472c-4ec6-97a6-\
e4e957fc4f66"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fxLocal", "[", "TST_", "]"}], ":=", 
   RowBox[{
    RowBox[{"-", "f"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"fzLocal", "[", "TST_", "]"}], ":=", 
   RowBox[{"f", " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellLabel->"In[23]:=",ExpressionUUID->"a0a0b5d7-dc04-41f2-b2bc-bffacad363db"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Static example : single solar time .", "Subsubsection",
 CellChangeTimes->{{3.983958664905993*^9, 
  3.983958668345421*^9}},ExpressionUUID->"34daf023-7d65-44d0-9d41-\
808259a85142"],

Cell["\<\
 Example of the parabolic profile at a fixed solar time.This allows \
visualizing the geometry of a single mirror section and its corresponding \
focal point.\
\>", "Text",
 CellChangeTimes->{{3.983887984950911*^9, 3.983888002712448*^9}, {
  3.983958662543538*^9, 
  3.9839586632955627`*^9}},ExpressionUUID->"66cb1a32-352b-44bf-90ab-\
60f339fdb690"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"exampleProfile", "=", 
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"ParametricPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"xLocal", "[", 
         RowBox[{"t", ",", "10"}], "]"}], ",", 
        RowBox[{"zLocal", "[", 
         RowBox[{"t", ",", "10"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"-", "4"}], ",", "4"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", "Thick"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<x [m]\>\"", ",", "\"\<z [m]\>\""}], "}"}]}], ",", 
      RowBox[{"PlotLabel", "->", "\"\<Local parabolic mirror profile\>\""}], 
      ",", 
      RowBox[{"LabelStyle", "->", 
       RowBox[{"Directive", "[", 
        RowBox[{"Black", ",", "Bold"}], "]"}]}]}], "]"}], ",", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fxLocal", "[", "10", "]"}], ",", 
         RowBox[{"fzLocal", "[", "10", "]"}]}], "}"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{"Red", ",", 
         RowBox[{"PointSize", "[", "Large", "]"}]}], "}"}]}]}], "]"}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.9830282752193117`*^9, 3.983028284775783*^9}, 
