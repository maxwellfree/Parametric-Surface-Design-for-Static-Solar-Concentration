}]}]}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Manipulate", "[", 
    RowBox[{
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sdir", ",", "sampledIndices", ",", 
         RowBox[{"incidentLen", "=", "1.8"}], ",", 
         RowBox[{"reflectedLen", "=", "2.4"}], ",", 
         RowBox[{"incidentRays", "=", 
          RowBox[{"{", "}"}]}], ",", 
         RowBox[{"reflectedRays", "=", 
          RowBox[{"{", "}"}]}], ",", "elevDeg", ",", "azDeg", ",", 
         "titleText", ",", "centralPoint", ",", "solarArrow"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"Solar", " ", "direction"}], "*)"}], 
       RowBox[{
        RowBox[{"sdir", "=", 
         RowBox[{"incidentDirection3D", "[", 
          RowBox[{"dn", ",", "TST"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"elevDeg", "=", 
         RowBox[{
          RowBox[{"h", "[", 
           RowBox[{"dn", ",", "TST"}], "]"}], "*", 
          RowBox[{"180", "/", "Pi"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"azDeg", "=", 
         RowBox[{
          RowBox[{"azimuth", "[", 
           RowBox[{"dn", ",", "TST"}], "]"}], "*", 
          RowBox[{"180", "/", "Pi"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Sparse", " ", "sampling", " ", "for", " ", "performance"}], 
         "*)"}], 
        RowBox[{"sampledIndices", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"i", ",", "j"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", "nCurves", ",", "curveStep"}], 
              "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", "nPts", ",", "pointStep"}], "}"}]}],
             "]"}], ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Ray", " ", "construction"}], "*)"}], 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"i", "=", 
               RowBox[{"idx", "[", 
                RowBox[{"[", "1", "]"}], "]"}]}], ",", 
              RowBox[{"j", "=", 
               RowBox[{"idx", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ",", "p", ",", "r"}], "}"}],
             ",", 
            RowBox[{
             RowBox[{"p", "=", 
              RowBox[{"surfaceGrid", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"illuminatedQ", "[", 
                RowBox[{"i", ",", "j", ",", "TST"}], "]"}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"incidentRays", ",", 
                  RowBox[{"Line", "[", 
                   RowBox[{"{", 
                    RowBox[{
                    RowBox[{"p", "-", 
                    RowBox[{"incidentLen", " ", "sdir"}]}], ",", "p"}], "}"}],
                    "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
                RowBox[{"r", "=", 
                 RowBox[{"reflectedDirAt", "[", 
                  RowBox[{"i", ",", "j", ",", "TST"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"rayHitsTubeQ", "[", 
                   RowBox[{"p", ",", "r", ",", "reflectedLen"}], "]"}], ",", 
                  RowBox[{"AppendTo", "[", 
                   RowBox[{"reflectedRays", ",", 
                    RowBox[{"Line", "[", 
                    RowBox[{"{", 
                    RowBox[{"p", ",", 
                    RowBox[{"p", "+", 
                    RowBox[{"reflectedLen", " ", "r"}]}]}], "}"}], "]"}]}], 
                   "]"}]}], "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"idx", ",", "sampledIndices"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", "Title", "*)"}], 
        RowBox[{"titleText", "=", 
         RowBox[{"Column", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<3D ray tracing at TST = \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"TST", ",", 
                  RowBox[{"{", 
                   RowBox[{"3", ",", "2"}], "}"}]}], "]"}], ",", 
                "\"\< h\>\""}], "}"}], "]"}], ",", 
             RowBox[{"Row", "[", 
              RowBox[{"{", 
               RowBox[{"\"\<Solar elevation = \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"elevDeg", ",", 
                  RowBox[{"{", 
                   RowBox[{"4", ",", "2"}], "}"}]}], "]"}], ",", 
                "\"\<\[Degree],   \>\"", ",", "\"\<Solar azimuth = \>\"", ",", 
                RowBox[{"NumberForm", "[", 
                 RowBox[{"azDeg", ",", 
                  RowBox[{"{", 
                   RowBox[{"5", ",", "2"}], "}"}]}], "]"}], ",", 
                "\"\<\[Degree]\>\""}], "}"}], "]"}]}], "}"}], ",", "Center"}],
           "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Final", " ", "visualization"}], "*)"}], 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ListPointPlot3D", "[", 
             RowBox[{
              RowBox[{"Flatten", "[", 
               RowBox[{"surfaceGrid", ",", "1"}], "]"}], ",", 
              RowBox[{"PlotStyle", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"Black", ",", 
                 RowBox[{"PointSize", "[", "0.0025", "]"}]}], "}"}]}], ",", 
              RowBox[{"BoxRatios", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"1", ",", "1", ",", "0.6"}], "}"}]}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Graphics3D", "[", 
             RowBox[{"{", 
              RowBox[{"Red", ",", 
               RowBox[{"Opacity", "[", "0.28", "]"}], ",", "reactorTube"}], 
              "}"}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Graphics3D", "[", 
             RowBox[{"{", 
              RowBox[{"Red", ",", 
               RowBox[{"PointSize", "[", "0.01", "]"}], ",", 
               RowBox[{"Point", "[", "reactorCenterline", "]"}]}], "}"}], 
             "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Graphics3D", "[", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Darker", "[", "Green", "]"}], ",", "Thick", ",", 
               "incidentRays"}], "}"}], "]"}], ",", "\[IndentingNewLine]", 
