Cell[CellGroupData[{

Cell["Horizontal projection", "Section",
 CellChangeTimes->{{3.983027904830419*^9, 
  3.983027914627987*^9}},ExpressionUUID->"da618fd1-48fb-49ab-a868-\
35c9b7b31aff"],

Cell["\<\
This block computes the horizontal projection of the solar direction for a \
selected day . The resulting curve represents the solar sweep in the xy - \
plane using the geometric convention adopted in this model. In this \
convention, the azimuth is not expressed in the standard astronomical \
reference frame, but as a signed geometric angle measured from the positive x \
- axis in the counterclockwise direction . This definition is the one used \
later to generate the parabolic sections and the three - dimensional mirror \
surface .\
\>", "Text",
 CellChangeTimes->{{3.9839585325358057`*^9, 3.9839585387421637`*^9}},
 TextJustification->1.,ExpressionUUID->"205758d5-d4ba-438c-8ccf-2dcdeeb91fc2"],

Cell[CellGroupData[{

Cell["Horizontal projection of the solar direction. ", "Subsubsection",
 CellChangeTimes->{{3.98388754153195*^9, 
  3.983887577828829*^9}},ExpressionUUID->"6aed2a42-c52a-4e43-ac3e-\
bf83f38c0214"],

Cell["\<\
Horizontal x - component of the solar direction . Cos[h] gives the magnitude \
of the horizontal projection, while Cos[azimuth] gives its component along \
the x - axis .\
\>", "Text",
 CellChangeTimes->{{3.9838875809478407`*^9, 
  3.98388758447939*^9}},ExpressionUUID->"8d038bfd-37f5-48b4-ba6a-\
e92075136f22"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"x", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
    RowBox[{"Cos", "[", 
     RowBox[{"azimuth", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.983887529452511*^9, 3.983887556100608*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"c02cd320-9e52-409b-9c36-d6800d3a5253"],

Cell["\<\
Horizontal y-component of the solar direction.Cos[h] gives the magnitude of \
the horizontal projection,while Sin[azimuth] gives its component along the \
y-axis.\
\>", "Text",
 CellChangeTimes->{{3.983887586794004*^9, 
  3.9838875929004908`*^9}},ExpressionUUID->"dc3e9908-8d2e-4591-a8b2-\
bb473e18a9f3"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"y", "[", 
    RowBox[{"dn_", ",", "TST_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"Cos", "[", 
     RowBox[{"h", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}], " ", 
    RowBox[{"Sin", "[", 
     RowBox[{"azimuth", "[", 
      RowBox[{"dn", ",", "TST"}], "]"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.983887571957573*^9},
 CellLabel->"In[12]:=",ExpressionUUID->"ef7975b7-a8e7-4ba1-8333-5ef093671d3c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Example of daily horizontal sweep.", "Subsubsection",
 CellChangeTimes->{{3.9839585608354473`*^9, 
  3.9839585731901913`*^9}},ExpressionUUID->"e20190b5-36d3-458d-81af-\
3aa2a09d06e5"],

Cell[" Example day and facade length used for visualization.", "Text",
 CellChangeTimes->{{3.9838876175216827`*^9, 3.9838876380368843`*^9}, 
   3.9839585583579187`*^9},ExpressionUUID->"adccacf7-18ab-4790-a305-\
f3506ce57f2e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dn", "=", "170"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"FacadeLength", "=", "30"}], ";"}]}], "Input",
 CellChangeTimes->{3.9838876132609177`*^9},
 CellLabel->"In[13]:=",ExpressionUUID->"caf46ef7-a1e7-4f0e-9bc3-03c2cf59828d"],

Cell["\<\
Normalization factor for the lateral excursion over the selected time \
interval.This avoids using a single endpoint as reference and keeps the sweep \
scaled to the facade width.\
\>", "Text",
 CellChangeTimes->{{3.9838876595091667`*^9, 
  3.9838876710376577`*^9}},ExpressionUUID->"54fe2e5a-dd6b-481a-849d-\
72c54f5e37bc"],

Cell[BoxData[
 RowBox[{
  RowBox[{"yNorm", "=", 
   RowBox[{"Max", "[", 
    RowBox[{"Abs", "@", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"y", "[", 
        RowBox[{"dn", ",", "hora"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"hora", ",", 
         RowBox[{"12", "-", "3"}], ",", 
         RowBox[{"12", "+", "3"}], ",", "0.01"}], "}"}]}], "]"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"889d01ef-3c37-429b-add2-81f34cfa06ef"],

Cell["\<\
Daily horizontal solar sweep in the adopted geometric convention . The x - \
component is kept in its natural normalized form, whereas the y - component \
is scaled to the facade width in order to visualize the region where the \
distributed reactor is placed .\
\>", "Text",
 CellChangeTimes->{{3.98388769515774*^9, 
  3.98388770575247*^9}},ExpressionUUID->"9baa53ad-56d5-4705-8f93-\
c8c7accba452"],

Cell[BoxData[
 RowBox[{
  RowBox[{"dataXY", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"x", "[", 
        RowBox[{"dn", ",", "hora"}], "]"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"FacadeLength", "/", "2"}], ")"}], " ", 
        RowBox[{
         RowBox[{"y", "[", 
          RowBox[{"dn", ",", "hora"}], "]"}], "/", "yNorm"}]}], ",", "0"}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"hora", ",", 
       RowBox[{"12", "-", "3"}], ",", 
       RowBox[{"12", "+", "3"}], ",", "0.01"}], "}"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"2ca53664-2c2b-4a90-8ed0-c0508a269391"]
}, Open  ]],

Cell[CellGroupData[{

Cell["3 D visualization of the horizontal solar path .", "Subsubsection",
 CellChangeTimes->{{3.983958584819765*^9, 
  3.983958589040704*^9}},ExpressionUUID->"111a25e9-1175-451b-acfd-\
75bfaf3fb5af"],

Cell["\<\
Although the curve lies in the plane z=0,ListPointPlot3D is used to maintain \
consistency with the later 3D representation of the mirror surface and focal \
trajectory.\
\>", "Text",
 CellChangeTimes->{{3.983887729589734*^9, 3.983887735420951*^9}, {
  3.9839585800146503`*^9, 
  3.983958583350746*^9}},ExpressionUUID->"e35f4baa-697e-4665-98e6-\
f524c224ec86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"horizontalSweep", "=", 
  RowBox[{"ListPointPlot3D", "[", 
   RowBox[{"dataXY", ",", 
    RowBox[{"AxesLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<x [m]\>\"", ",", "\"\<y [m]\>\"", ",", "\"\<z [m]\>\""}], 
      "}"}]}], ",", 
    RowBox[{
    "PlotLabel", "->", 
     "\"\<Horizontal solar sweep in the model reference frame\>\""}], ",", 
    RowBox[{"PlotTheme", "->", "\"\<Marketing\>\""}], ",", 
    RowBox[{"LabelStyle", "->", 
     RowBox[{"Directive", "[", 
      RowBox[{"Black", ",", "Bold"}], "]"}]}], ",", 
    RowBox[{"AspectRatio", "->", "1"}], ",", 
    RowBox[{"ImageSize", "\[Rule]", "1000"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.983027930871683*^9, 3.983027936684876*^9}, 
   3.9834394155208607`*^9, 3.983440601164844*^9, 3.9838813431229143`*^9, 
   3.983881419765388*^9, {3.983881534594206*^9, 3.9838815614754057`*^9}, {
