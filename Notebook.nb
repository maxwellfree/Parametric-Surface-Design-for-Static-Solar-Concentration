    "number", " ", "of", " ", "bins", " ", "to", " ", "resolve", " ", "the", 
     " ", "distribution", " ", "with", " ", "sufficient", " ", "detail"}], 
    "*)"}], 
   RowBox[{"Frame", "\[Rule]", "True"}], ",", 
