Cell[CellGroupData[{

Cell["Quantitative comparison between day 170 and day 176", "Subsubsection",
 CellChangeTimes->{{3.983961424145341*^9, 
  3.983961432061438*^9}},ExpressionUUID->"4dbc36db-afd3-474f-87ed-\
bc04f29989eb"],

Cell["\<\
This block compares the mirror surfaces and focal trajectories obtained for \
day 145 and day 200. Since both surfaces are generated with the same \
parameter sampling in solar time and in the local parabola parameter t,a \
point-to-point comparison can be performed directly.The goal is to quantify \
how close both parametric surfaces are over the selected summer operating \
interval.\
\>", "Text",
 CellChangeTimes->{{3.983961427728508*^9, 
  3.98396143560602*^9}},ExpressionUUID->"ff07116b-b57e-4e9b-9ce3-\
16742bf91ecf"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Pointwise", " ", "Euclidean", " ", "distances", " ", "between", " ", 
    "both", " ", "mirror", " ", "surfaces"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"surfacePointDistances", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"EuclideanDistance", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"SurfacesDay145", ",", "1"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"SurfacesDay200", ",", "1"}], "]"}]}], "}"}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Pointwise", " ", "Euclidean", " ", "distances", " ", "between", " ", 
     "both", " ", "focal", " ", "trajectories"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"focusPointDistances", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"EuclideanDistance", ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Flatten", "[", 
          RowBox[{"ReactorDay145", ",", "1"}], "]"}], ",", 
         RowBox[{"Flatten", "[", 
          RowBox[{"ReactorDay200", ",", "1"}], "]"}]}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellLabel->"In[46]:=",ExpressionUUID->"6d206da4-5d87-4dfe-b0df-82b1c5cd000e"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Summary statistics for the geometric comparison", "Subsubsection",
 CellChangeTimes->{{3.983961469399988*^9, 
  3.9839614746692333`*^9}},ExpressionUUID->"af48f6cb-8f27-42c3-ac11-\
973051e782ac"],

Cell["\<\
The following quantities summarize the pointwise geometric differences \
between the two mirror surfaces and between their corresponding focal \
trajectories.These indicators are computed from the Euclidean distances \
previously obtained for all matched points.The goal is to quantify,in a \
compact form,how similar both configurations are.\
\>", "Text",
 CellChangeTimes->{{3.98396146348562*^9, 
  3.9839614929173203`*^9}},ExpressionUUID->"41735b3c-b51d-4154-8847-\
77f2556cdff1"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Maximum", " ", "pointwise", " ", "deviation", " ", "on", " ", "the", " ",
      "mirror", " ", 
     RowBox[{"surface", ".", "This"}], " ", "is", " ", "the", " ", "largest", 
     " ", "Euclidean", " ", "distance", " ", "found", " ", "between", " ", 
     "any", " ", "pair", " ", "of", " ", "corresponding", " ", "surface", " ", 
     RowBox[{"points", ".", "It"}], " ", "provides", " ", "a", " ", "worst"}],
     "-", 
    RowBox[{
    "case", " ", "estimate", " ", "of", " ", "the", " ", "geometric", " ", 
     "discrepancy", " ", "between", " ", "both", " ", 
     RowBox[{"surfaces", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"surfaceMaxError", "=", 
     RowBox[{"Max", "[", "surfacePointDistances", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Mean", " ", "pointwise", " ", "deviation", " ", "on", " ", "the", " ", 
     "mirror", " ", 
     RowBox[{"surface", ".", "This"}], " ", "is", " ", "the", " ", 
     "arithmetic", " ", "average", " ", "of", " ", "all", " ", "pointwise", 
     " ", "distances", " ", "over", " ", "the", " ", "full", " ", 
     RowBox[{"surface", ".", "It"}], " ", "provides", " ", "a", " ", "global",
      " ", "estimate", " ", "of", " ", "the", " ", "typical", " ", 
     "geometric", " ", "difference", " ", "between", " ", "both", " ", 
     "mirror", " ", 
     RowBox[{"configurations", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"surfaceMeanError", "=", 
     RowBox[{"Mean", "[", "surfacePointDistances", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Root", "-", "mean", "-", 
     RowBox[{
     "square", " ", "deviation", " ", "on", " ", "the", " ", "mirror", " ", 
      RowBox[{"surface", ".", "The"}], " ", "RMS", " ", "error", " ", "gives",
       " ", "a", " ", "measure", " ", "of", " ", "the", " ", "overall", " ", 
      "discrepancy", " ", "while", " ", "assigning", " ", "greater", " ", 
      "weight", " ", "to", " ", "larger", " ", "local", " ", 
      RowBox[{"deviations", ".", "This"}], " ", "is", " ", "useful", " ", 
      "to", " ", "detect", " ", "whether", " ", "the", " ", "differences", 
      " ", "are", " ", "uniformly", " ", "small", " ", "or", " ", "whether", 
      " ", "a", " ", "few", " ", "larger", " ", "departures", " ", "dominate",
       " ", "the", " ", 
      RowBox[{"comparison", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"surfaceRMSError", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{"surfacePointDistances", "^", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Maximum", " ", "pointwise", " ", "deviation", " ", "on", " ", "the", " ",
      "focal", " ", 
     RowBox[{"trajectory", ".", "This"}], " ", "is", " ", "the", " ", 
     "largest", " ", "Euclidean", " ", "distance", " ", "between", " ", "any",
      " ", "pair", " ", "of", " ", "corresponding", " ", "focal", " ", 
     RowBox[{"points", ".", "It"}], " ", "represents", " ", "the", " ", 
     "maximum", " ", "displacement", " ", "of", " ", "the", " ", "focal", " ",
      "path", " ", "between", " ", "the", " ", "two", " ", "compared", " ", 
     RowBox[{"days", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"focusMaxError", "=", 
     RowBox[{"Max", "[", "focusPointDistances", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Mean", " ", "pointwise", " ", "deviation", " ", "on", " ", "the", " ", 
     "focal", " ", 
     RowBox[{"trajectory", ".", "This"}], " ", "value", " ", "represents", 
     " ", "the", " ", "average", " ", "displacement", " ", "of", " ", "the", 
     " ", "focal", " ", "trajectory", " ", "over", " ", "the", " ", "full", 
     " ", "daily", " ", "operating", " ", 
     RowBox[{"interval", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"focusMeanError", "=", 
     RowBox[{"Mean", "[", "focusPointDistances", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Root", "-", "mean", "-", 
      RowBox[{
      "square", " ", "deviation", " ", "on", " ", "the", " ", "focal", " ", 
       RowBox[{"trajectory", ".", "As"}], " ", "in", " ", "the", " ", "case", 
       " ", "of", " ", "the", " ", "surface"}]}], ",", 
     RowBox[{
      RowBox[{
      "this", " ", "quantity", " ", "emphasizes", " ", "larger", " ", "local",
        " ", "departures", " ", "and", " ", "provides", " ", "an", " ", 
       "overall", " ", "measure", " ", "of", " ", "the", " ", "focal"}], "-", 
      
      RowBox[{"path", " ", 
       RowBox[{"discrepancy", "."}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"focusRMSError", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"Mean", "[", 
       RowBox[{"focusPointDistances", "^", "2"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Collect", " ", "all", " ", "summary", " ", "indicators", " ", "in", " ", 
     "a", " ", "single", " ", "association", " ", "for", " ", "convenient", 
     " ", "inspection", " ", "and", " ", 
     RowBox[{"reporting", ".", "These"}], " ", "values", " ", "can", " ", 
     "be", " ", "directly", " ", "quoted", " ", "in", " ", "the", " ", 
     "manuscript", " ", "in", " ", "order", " ", "to", " ", "demonstrate", 
     " ", "that", " ", "the", " ", "geometric", " ", "differences", " ", 
     "between", " ", "both", " ", "days", " ", "remain", " ", 
     RowBox[{"negligible", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"comparisonSummary", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Surface max error [m]\>\"", "\[Rule]", "surfaceMaxError"}],
       ",", 
      RowBox[{
