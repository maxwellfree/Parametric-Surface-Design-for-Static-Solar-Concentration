     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "10"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"viewChoice", "[", "\"\<SideXZ\>\"", "]"}], ":=", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{"-", "10"}], ",", "0"}], "}"}]}], ";"}], "\n", 
