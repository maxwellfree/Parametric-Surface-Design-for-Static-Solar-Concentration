 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"uniformityDataAtTST", "[", 
     RowBox[{"TST_", ",", 
      RowBox[{"rayLen_", ":", "3.0"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "data", ",", "hitData", ",", "weights", ",", "hitPts", ",", "sCoords", 
        ",", "binIndex", ",", "powerBins", ",", "qBins", ",", "meanQ", ",", 
        "stdQ", ",", "cvQ", ",", "uniformityIndex"}], "}"}], ",", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"rayTracingDataAtTST", "[", 
         RowBox[{"TST", ",", "rayLen"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", 
        RowBox[{
        "Keep", " ", "only", " ", "rays", " ", "that", " ", "hit", " ", "and",
          " ", "whose", " ", "hit", " ", "point", " ", "is", " ", "a", " ", 
         "valid", " ", "3", "D", " ", "point"}], "*)"}], 
       RowBox[{"hitData", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"data", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"TrueQ", "[", 
             RowBox[{"#", "[", "\"\<HitQ\>\"", "]"}], "]"}], "&&", 
            RowBox[{"validPointQ", "[", 
             RowBox[{"#", "[", "\"\<HitPoint\>\"", "]"}], "]"}]}], "&"}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "hitData", "]"}], "==", "0"}], ",", 
         RowBox[{"Return", "[", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<TST\>\"", "->", "TST"}], ",", 
            RowBox[{"\"\<PowerBins\>\"", "->", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.0", ",", "nBinsUniformity"}], "]"}]}], ",", 
            RowBox[{"\"\<PowerDensityBins\>\"", "->", 
             RowBox[{"ConstantArray", "[", 
              RowBox[{"0.0", ",", "nBinsUniformity"}], "]"}]}], ",", 
            RowBox[{"\"\<MeanPowerDensity\>\"", "->", "0.0"}], ",", 
            RowBox[{"\"\<StdPowerDensity\>\"", "->", "0.0"}], ",", 
            RowBox[{"\"\<UniformityCV\>\"", "->", "Indeterminate"}], ",", 
            RowBox[{"\"\<UniformityIndex\>\"", "->", "Indeterminate"}]}], 
           "|>"}], "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Relative", " ", "reflected", " ", "power", " ", "weight", " ", "per",
          " ", "hit", " ", 
         RowBox[{"patch", ".", "DNI"}], " ", "is", " ", "omitted", " ", 
         "because", " ", "it", " ", "is", " ", "common", " ", "to", " ", 
         "all", " ", "rays", " ", "at", " ", "fixed", " ", "TST", " ", "and", 
         " ", "cancels", " ", "out", " ", "in", " ", "the", " ", "uniformity",
          " ", 
         RowBox[{"ratios", "."}]}], "*)"}], 
       RowBox[{"weights", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"rhoMirror", "*", 
            RowBox[{"#", "[", "\"\<Weight\>\"", "]"}]}], ")"}], "&"}], "/@", 
         "hitData"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Hit", " ", "points", " ", "on", " ", "the", " ", "reactor"}],
         "*)"}], "\[IndentingNewLine]", 
       RowBox[{"hitPts", "=", 
        RowBox[{"hitData", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "\"\<HitPoint\>\""}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Arc", " ", "coordinate", " ", "along", " ", "reactor"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"sCoords", "=", 
        RowBox[{"nearestArcCoordinate", "/@", "hitPts"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Assign", " ", "each", " ", "hit", " ", "to", " ", "nearest", " ", 
         "axial", " ", "bin"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"binIndex", "=", 
        RowBox[{"First", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Nearest", "[", 
             RowBox[{"binRule", ",", "#"}], "]"}], "&"}], "/@", "sCoords"}], 
          ")"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Accumulate", " ", "power", " ", "per", " ", "bin"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"powerBins", "=", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0.0", ",", "nBinsUniformity"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"powerBins", "[", 
           RowBox[{"[", 
            RowBox[{"binIndex", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "]"}], "]"}], "+=", 
          RowBox[{"weights", "[", 
           RowBox[{"[", "k", "]"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"Length", "[", "weights", "]"}]}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Local", " ", "power", " ", "density"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"qBins", "=", 
        RowBox[{"N", "[", 
         RowBox[{"powerBins", "/", "binAreas"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"meanQ", "=", 
        RowBox[{"N", "[", 
         RowBox[{"Mean", "[", "qBins", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"stdQ", "=", 
        RowBox[{"N", "[", 
         RowBox[{"StandardDeviation", "[", "qBins", "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"cvQ", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericQ", "[", "meanQ", "]"}], "&&", 
           RowBox[{"meanQ", ">", "0"}]}], ",", 
          RowBox[{"N", "[", 
           RowBox[{"stdQ", "/", "meanQ"}], "]"}], ",", "Indeterminate"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"uniformityIndex", "=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"NumericQ", "[", "meanQ", "]"}], "&&", 
           RowBox[{"meanQ", ">", "0"}]}], ",", 
          RowBox[{"N", "[", 
           RowBox[{"1", "-", 
            RowBox[{"stdQ", "/", "meanQ"}]}], "]"}], ",", "Indeterminate"}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<TST\>\"", "->", "TST"}], ",", 
         RowBox[{"\"\<PowerBins\>\"", "->", "powerBins"}], ",", 
         RowBox[{"\"\<PowerDensityBins\>\"", "->", "qBins"}], ",", 
         RowBox[{"\"\<MeanPowerDensity\>\"", "->", "meanQ"}], ",", 
         RowBox[{"\"\<StdPowerDensity\>\"", "->", "stdQ"}], ",", 
         RowBox[{"\"\<UniformityCV\>\"", "->", "cvQ"}], ",", 
         RowBox[{"\"\<UniformityIndex\>\"", "->", "uniformityIndex"}]}], 
        "|>"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
