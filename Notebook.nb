     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "vals", ",", "meanVal", ",", "minVal", ",", "maxVal", ",", "rangeAbs",
          ",", "rangeRel", ",", "stdVal", ",", "cvVal"}], "}"}], ",", 
       RowBox[{
        RowBox[{"vals", "=", 
